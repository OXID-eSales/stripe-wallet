{% extends "module_config.html.twig" %}

{% block admin_module_config_var %}
    {% if module_var == 'sStripeTestToken' or module_var == 'sStripeLiveToken' or module_var == 'sStripeTestPk' or module_var == 'sStripeLivePk' %}
        {# Sprint 39: Show warning banner if API keys are from different Stripe accounts #}
        {% if module_var == 'sStripeTestToken' %}
            {% if attribute(oView, 'stripeGetKeyValidationError') is defined %}
                {% set keyValidationError = oView.stripeGetKeyValidationError() %}
                {% if keyValidationError %}
                    <div style="background: #fff3cd; border: 1px solid #ffc107; padding: 12px 15px; margin-bottom: 15px; border-radius: 4px;">
                        <strong style="color: #856404;">&#9888; {{ translate({ ident: "STRIPE_KEY_MISMATCH_WARNING" }) }}</strong>
                        <p style="color: #856404; margin: 8px 0 0 0; font-size: 12px;">{{ keyValidationError }}</p>
                    </div>
                {% endif %}
            {% endif %}
        {% endif %}
        {% if module_var == 'sStripeTestToken' or module_var == 'sStripeLiveToken' %}
            <dl>
                <dt>
                    <div>
                        <input type="text" readonly disabled class="txt" style="width: 250px;" name="confstrs[{{ module_var }}]" value="{{ confstrs[module_var] }}" {{ readonly }}>
                        {% include "inputhelp.html.twig" with {'sHelpId': help_id("HELP_SHOP_MODULE_" ~ module_var), 'sHelpText': help_text("HELP_SHOP_MODULE_" ~ module_var)} %}
                        <br/>
                        {% if confstrs[module_var] %}
                            <span id="{{ module_var }}_status" style="color: green">{{ translate({ ident: "STRIPE_APIKEY_CONNECTED" }) }}</span>
                        {% endif %}
                    </div>
                </dt>
                <dd style="white-space: nowrap;">
                    <span style="float:left;">{{ translate({ ident: "SHOP_MODULE_" ~ module_var }) }}</span>
                    <span><a href="{{ oView.stripeGetConnectUrl(module_var) }}" class="stripe-connect" target="_blank" rel="noreferrer noopener"><span>{{ translate({ ident: "STRIPE_CONNECT_WITH" }) }}</span></a></span>
                </dd>
                <div class="spacer"></div>
            </dl>
        {% else %}
            {# Publishable key fields - editable to allow manual correction of mismatched keys #}
            <dl>
                <dt>
                    <input type="text" class="txt" style="width: 250px;" name="confstrs[{{ module_var }}]" value="{{ confstrs[module_var] }}" {{ readonly }}>
                    {% include "inputhelp.html.twig" with {'sHelpId': help_id("HELP_SHOP_MODULE_" ~ module_var), 'sHelpText': help_text("HELP_SHOP_MODULE_" ~ module_var)} %}
                </dt>
                <dd style="white-space: nowrap;">
                    <span style="float:left;">{{ translate({ ident: "SHOP_MODULE_" ~ module_var }) }}</span>
                </dd>
                <div class="spacer"></div>
            </dl>
        {% endif %}
        {% if module_var == 'sStripeLivePk' %}
            <dl>
                <dt></dt>
                <dd>{{ translate({ ident: "STRIPE_CONNECTION_DATA" }) }} <a href="https://dashboard.stripe.com" target="_blank">https://dashboard.stripe.com</a></dd>
                <div class="spacer"></div>
            </dl>
        {% endif %}
    {% elseif module_var == 'sStripeWebhookEndpoint' %}
        <dl>
            <dt>
                <input type="text" id="stripe-webhook-endpoint-input" class="txt" style="width: 350px;" name="confstrs[{{ module_var }}]" value="{{ confstrs[module_var] }}" readonly placeholder="https://…">
                {% include "inputhelp.html.twig" with {'sHelpId': help_id("HELP_SHOP_MODULE_" ~ module_var), 'sHelpText': help_text("HELP_SHOP_MODULE_" ~ module_var)} %}
                <br/>
                <span id="stripe-webhook-status" style="margin-top: 4px; display: inline-block;">
                    {% if oView.stripeIsWebhookConfigured() %}
                        <span style="color: green;">&#10003; {{ translate({ ident: "STRIPE_WEBHOOK_CONFIGURED" }) }}</span>
                    {% else %}
                        <span style="color: orange;">&#9888; {{ translate({ ident: "STRIPE_WEBHOOK_NOT_CONFIGURED" }) }}</span>
                    {% endif %}
                </span>
                <br/>
                {% if not oView.stripeIsPlatformKeyConfigured() %}
                    <span class="help-block" style="color: #888; font-size: 12px;">
                        {{ translate({ ident: "STRIPE_WEBHOOK_PLATFORM_KEY_MISSING" }) }}
                    </span>
                {% endif %}
                <button
                    type="button"
                    id="stripe-create-webhook-button"
                    class="btn btn-default"
                    style="margin-top: 6px;"
                    {{ not oView.stripeIsPlatformKeyConfigured() ? 'disabled' : '' }}
                >{{ translate({ ident: "STRIPE_WEBHOOK_CREATE_BUTTON" }) }}</button>
                <button
                    type="button"
                    id="stripe-clear-webhooks-button"
                    class="btn btn-default"
                    style="margin-top: 6px; margin-left: 4px;"
                    {{ not oView.stripeIsPlatformKeyConfigured() ? 'disabled' : '' }}
                >{{ translate({ ident: "STRIPE_WEBHOOK_CLEAR_ALL_BUTTON" }) }}</button>
                <span id="stripe-webhook-msg" style="margin-left: 1em;"></span>

                <script>
                (function () {
                    var btn = document.getElementById('stripe-create-webhook-button');
                    var msg = document.getElementById('stripe-webhook-msg');
                    var statusEl = document.getElementById('stripe-webhook-status');
                    if (!btn) { return; }

                    btn.addEventListener('click', function () {
                        btn.disabled = true;
                        msg.textContent = '…';

                        var xhr = new XMLHttpRequest();
                        var url = '{{ oView.stripeGetCreateWebhookUrl()|raw }}';
                        xhr.open('POST', url, true);
                        xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
                        xhr.onload = function () {
                            btn.disabled = false;
                            var data = null;
                            try { data = JSON.parse(xhr.responseText); } catch (e) { /* non-JSON response */ }
                            if (data && data.success) {
                                msg.style.color = 'green';
                                msg.textContent = '✓ ' + (data.endpointId || '');
                                statusEl.innerHTML = '<span style="color: green;">&#10003; {{ translate({ ident: "STRIPE_WEBHOOK_CONFIGURED" }) }}</span>';
                                var urlInput = document.getElementById('stripe-webhook-endpoint-input');
                                if (urlInput && data.webhookUrl) { urlInput.value = data.webhookUrl; }
                                var secretInput = document.querySelector('input[name="confstrs[sStripeWebhookEndpointSecret]"]');
                                if (secretInput && data.endpointSecret) { secretInput.value = data.endpointSecret; }
                                return;
                            }
                            msg.style.color = 'red';
                            if (data && data.message) {
                                msg.textContent = '✗ ' + data.message;
                                return;
                            }
                            // Non-JSON response (server fatal, 404, offline page, etc.) — keep the UI clean,
                            // surface details only to the developer via console.
                            console.error('Stripe Create-webhook: unexpected response', xhr.status, xhr.responseText);
                            msg.textContent = '✗ {{ translate({ ident: "STRIPE_WEBHOOK_CREATE_ERROR" }) }} (HTTP ' + xhr.status + ')';
                        };
                        xhr.onerror = function () {
                            msg.style.color = 'red';
                            msg.textContent = '✗ {{ translate({ ident: "STRIPE_WEBHOOK_CREATE_ERROR" }) }}';
                            btn.disabled = false;
                        };
                        xhr.send();
                    });

                    var clearBtn = document.getElementById('stripe-clear-webhooks-button');
                    if (!clearBtn) { return; }

                    clearBtn.addEventListener('click', function () {
                        if (!confirm('{{ translate({ ident: "STRIPE_WEBHOOK_CLEAR_ALL_CONFIRM" }) }}')) { return; }
                        clearBtn.disabled = true;
                        btn.disabled = true;
                        msg.style.color = '';
                        msg.textContent = '…';

                        var xhr = new XMLHttpRequest();
                        xhr.open('POST', '{{ oView.stripeGetClearWebhooksUrl()|raw }}', true);
                        xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
                        xhr.onload = function () {
                            clearBtn.disabled = false;
                            btn.disabled = false;
                            var data = null;
                            try { data = JSON.parse(xhr.responseText); } catch (e) { /* non-JSON */ }
                            if (data && data.success) {
                                msg.style.color = 'green';
                                msg.textContent = '✓ ' + (data.deleted || 0) + ' deleted';
                                statusEl.innerHTML = '<span style="color: orange;">&#9888; {{ translate({ ident: "STRIPE_WEBHOOK_NOT_CONFIGURED" }) }}</span>';
                                var urlInput = document.getElementById('stripe-webhook-endpoint-input');
                                if (urlInput) { urlInput.value = ''; }
                                var secretInput = document.querySelector('input[name="confstrs[sStripeWebhookEndpointSecret]"]');
                                if (secretInput) { secretInput.value = ''; }
                                return;
                            }
                            msg.style.color = 'red';
                            if (data && data.message) { msg.textContent = '✗ ' + data.message; return; }
                            console.error('Stripe Clear-webhooks: unexpected response', xhr.status, xhr.responseText);
                            msg.textContent = '✗ {{ translate({ ident: "STRIPE_WEBHOOK_CLEAR_ALL_ERROR" }) }} (HTTP ' + xhr.status + ')';
                        };
                        xhr.onerror = function () {
                            msg.style.color = 'red';
                            msg.textContent = '✗ {{ translate({ ident: "STRIPE_WEBHOOK_CLEAR_ALL_ERROR" }) }}';
                            clearBtn.disabled = false;
                            btn.disabled = false;
                        };
                        xhr.send();
                    });
                }());
                </script>
            </dt>
            <dd style="white-space: nowrap;">
                <span style="float:left;">{{ translate({ ident: "SHOP_MODULE_" ~ module_var }) }}</span>
            </dd>
            <div class="spacer"></div>
        </dl>
    {% elseif module_var == 'sStripeWebhookEndpointSecret' %}
        <dl>
            <dt>
                <input type="text" class="txt" style="width: 350px;" name="confstrs[{{ module_var }}]" value="{{ confstrs[module_var] }}" {{ readonly }} placeholder="whsec_...">
                {% include "inputhelp.html.twig" with {'sHelpId': help_id("HELP_SHOP_MODULE_" ~ module_var), 'sHelpText': help_text("HELP_SHOP_MODULE_" ~ module_var)} %}
            </dt>
            <dd style="white-space: nowrap;">
                <span style="float:left;">{{ translate({ ident: "SHOP_MODULE_" ~ module_var }) }}</span>
                {% if confstrs[module_var] %}
                    <span style="margin-left: 1em; color: green;">&#10003; {{ translate({ ident: "STRIPE_WEBHOOK_CONFIGURED" }) }}</span>
                {% else %}
                    <span style="margin-left: 1em; color: orange;">&#9888; {{ translate({ ident: "STRIPE_WEBHOOK_NOT_SET" }) }}</span>
                {% endif %}
            </dd>
            <div class="spacer"></div>
        </dl>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block admin_module_config_form %}
    {{ parent() }}

    {% if attribute(oView, 'stripeIsStripe')  is defined and oView.stripeIsStripe() is same as(true) %}
        <style type="text/css">
            .stripe-connect {
                background: #635bff;
                display: inline-block;
                height: 38px;
                text-decoration: none;
                width: 180px;
                margin-left: 10px;

                border-radius: 4px;
                -moz-border-radius: 4px;
                -webkit-border-radius: 4px;

                user-select: none;
                -moz-user-select: none;
                -webkit-user-select: none;
                -ms-user-select: none;

                -webkit-font-smoothing: antialiased;
            }

            .stripe-connect span {
                color: #ffffff;
                display: block;
                font-family: sohne-var, "Helvetica Neue", Arial, sans-serif;
                font-size: 15px;
                font-weight: 400;
                line-height: 14px;
                padding: 11px 0px 0px 24px;
                position: relative;
                text-align: left;
            }

            .stripe-connect:hover {
                background: #7a73ff;
            }

            .stripe-connect.slate {
                background: #0a2540;
            }

            .stripe-connect.slate:hover {
                background: #425466;
            }

            .stripe-connect.white {
                background: #ffffff;
            }

            .stripe-connect.white span {
                color: #0a2540;
            }

            .stripe-connect.white:hover {
                background: #f6f9fc;
            }

