            /* ============================================================
               Sprint 114 — Stripe module config: lift the payment-tab look
               (cards, soft borders, Stripe-purple accents, modern inputs).
               Scoped to .module_config so we don't bleed into other admin pages.
               ============================================================ */
            body.module_config {
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
                font-size: 13px;
                color: #1a1a2e;
            }

            /* Inputs + selects */
            body.module_config input[type="text"],
            body.module_config input[type="password"],
            body.module_config select.editinput,
            body.module_config select {
                padding: 3px 8px;
                border: 1px solid #d1d5db;
                border-radius: 4px;
                font-size: 12.5px;
                font-family: inherit;
                color: #1a1a2e;
                background: #fff;
                line-height: 18px;
                height: 26px;
                box-sizing: border-box;
                vertical-align: middle;
                transition: border-color .15s, box-shadow .15s;
            }
            body.module_config input[type="text"]:focus,
            body.module_config input[type="password"]:focus,
            body.module_config select:focus {
                border-color: #635bff;
                outline: none;
                box-shadow: 0 0 0 3px rgba(99,91,255,.15);
            }
            body.module_config input[readonly][disabled],
            body.module_config input[disabled] {
                background: #f9fafb;
                color: #6b7280;
            }

            /* Checkbox / radio + their adjacent label text share a center line. */
            body.module_config input[type="checkbox"],
            body.module_config input[type="radio"] {
                vertical-align: middle;
                margin: 0 4px 0 0;
                position: relative;
                top: -1px;
            }

            /* Setting rows — vertically center dt (widget) and dd (label) on a row.
               OXID's parent template floats dt left and the label sits in dd; we
               give every direct child of dt a baseline middle so widgets and their
               labels share the same center line. */
            body.module_config dl {
                padding: 4px 0;
            }
            body.module_config dl dt,
            body.module_config dl dd {
                vertical-align: middle;
                line-height: 26px;
            }
            body.module_config dl dt > *,
            body.module_config dl dt > div > * {
                vertical-align: middle;
            }
            body.module_config dl dd { color: #4b5563; font-size: 12.5px; }
            body.module_config dl dd label { vertical-align: middle; }

            /* Sprint 114: labels in <dd> sit centered with the widget in <dt>.
               Old template used inline float:left which pulled them to the top
               of the row. */
            body.module_config dl dd .smc-label {
                display: inline-block;
                vertical-align: middle;
                line-height: 26px;
                margin-right: 6px;
            }
            body.module_config dl dd > span {
                vertical-align: middle;
            }

            /* Group headers (collapsible "Basic configuration", "Webhooks") */
            body.module_config .groupExp {
                background: #f9fafb;
                border: 1px solid #e5e7eb;
                border-radius: 8px;
                padding: 10px 14px;
                font-weight: 600;
                font-size: 14px;
                color: #1a1a2e;
                margin: 16px 0 8px;
                cursor: pointer;
            }
            body.module_config .groupExp:hover { background: #f3f4f6; }

            /* Bottom "Save" / "Reset" button bar */
            body.module_config input[type="submit"],
            body.module_config input.edittext {
                background: #635bff;
                color: #fff;
                border: none;
                border-radius: 6px;
                padding: 8px 18px;
                font-weight: 500;
                font-size: 13px;
                cursor: pointer;
                transition: background .15s;
            }
            body.module_config input[type="submit"]:hover,
            body.module_config input.edittext:hover {
                background: #4b45c6;
            }

            .groupExp dt .select {
                width: inherit !important;
            }

            /* Sprint 113: sensitive-key fields render with type=password + eye toggle. */
            .stripe-key-field {
                display: inline-block;
                white-space: nowrap;
            }
            .stripe-key-toggle {
                background: transparent;
                border: 1px solid #d1d5db;
                border-radius: 4px;
                padding: 0 6px;
                cursor: pointer;
                font-size: 12px;
                line-height: 24px;
                margin-left: 6px;
                vertical-align: middle;
                height: 26px;
                box-sizing: border-box;
                color: #6b7280;
                transition: border-color .15s, color .15s, background .15s;
            }
            .stripe-key-toggle:hover {
                background: #f9fafb;
                border-color: #635bff;
                color: #635bff;
            }
            .stripe-key-toggle:focus {
                outline: none;
                border-color: #635bff;
                box-shadow: 0 0 0 3px rgba(99,91,255,.15);
            }
            .stripe-key-toggle[aria-pressed="true"] {
                background: #eef0ff;
                border-color: #635bff;
                color: #4b45c6;
            }

            /* Stripe-tab-style alerts, badges, status hints */
            .smc-alert {
                padding: 12px 16px;
                border-radius: 8px;
                margin-bottom: 12px;
                font-size: 13px;
                display: flex;
                align-items: flex-start;
                gap: 10px;
            }
            .smc-alert-warning { background: #fffbeb; border: 1px solid #fde68a; color: #92400e; }
            .smc-alert-warning strong { color: #78350f; font-weight: 600; }
            .smc-alert-warning p { margin: 4px 0 0; font-size: 12px; color: #78350f; }
            .smc-alert-info    { background: #eff6ff; border: 1px solid #bfdbfe; color: #1e40af; }
            .smc-alert-muted   { background: #f9fafb; border: 1px solid #e5e7eb; color: #6b7280; padding: 8px 12px; border-radius: 6px; font-size: 12px; }

            .smc-status-ok   { color: #059669; font-weight: 500; }
            .smc-status-warn { color: #d97706; font-weight: 500; }
            .smc-status-muted { color: #9ca3af; font-size: 12px; }

            /* Stripe-tab-style buttons for the webhook section */
            .smc-btn {
                display: inline-block;
                padding: 7px 14px;
                border: none;
                border-radius: 6px;
                font-size: 13px;
                font-weight: 500;
                font-family: inherit;
                cursor: pointer;
                text-decoration: none;
                margin-top: 6px;
                transition: background .15s, color .15s, border-color .15s;
            }
            .smc-btn-primary { background: #635bff; color: #fff; }
            .smc-btn-primary:hover { background: #4b45c6; }
            .smc-btn-primary:disabled { background: #c7c5ef; cursor: not-allowed; }
            .smc-btn-danger-outline { background: #fff; color: #dc2626; border: 1px solid #fca5a5; }
            .smc-btn-danger-outline:hover { background: #fef2f2; }
            .smc-btn-danger-outline:disabled { color: #fca5a5; cursor: not-allowed; }

            .smc-msg { margin-left: 10px; font-size: 12px; vertical-align: middle; }
        </style>

        <script>
        (function () {
            function attach(button) {
                var wrapper = button.parentElement;
                var input = wrapper && wrapper.querySelector('input[data-stripe-secret]');
                if (!input) { return; }
                button.addEventListener('click', function () {
                    var revealing = input.type === 'password';
                    input.type = revealing ? 'text' : 'password';
                    button.setAttribute('aria-pressed', revealing ? 'true' : 'false');
                    var newLabel = revealing
                        ? button.getAttribute('data-label-hide')
                        : button.getAttribute('data-label-reveal');
                    if (newLabel) { button.setAttribute('aria-label', newLabel); }
                });
            }
            function init() {
                document.querySelectorAll('button.stripe-key-toggle').forEach(attach);
            }
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
            } else {
                init();
            }
        }());
        </script>
    {% endif %}
{% endblock %}
