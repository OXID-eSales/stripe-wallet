{% extends "page/checkout/order.html.twig" %}

{% set payment = oView.getPayment() %}
{% set paymentId = payment.getId() %}

{% block base_js %}
    {{ parent() }}
    {% include '@oe_payments_stripe_wallet/frontend/base_js.html.twig' %}
{% endblock %}

{# STRP-129: container for the JS-rendered user-data validation error box.
   Sits where OXID's standard errors render (top of the order page, above the
   form). The order-submit controller fills it on a 422 validation response. #}
{% block checkout_order_errors %}
    {{ parent() }}
    {% if payment.isStripePaymentMethod() %}
        {# Match the checkout content width (same container/column as the order blocks). #}
        <div class="container-md">
            <div class="row justify-content-center">
                <div class="col-md-12 col-lg-10 col-xl-10 col-xxl-6">
                    <div id="stripe-validation-errors" class="mt-3"
                         data-stripe-validation-understand="{{ translate({ ident: 'STRIPE_VALIDATION_UNDERSTAND' }) }}"></div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block shippingAndPayment %}
    {% if payment.isStripePaymentMethod() == false %}
        {{ parent() }}
    {% else %}
        <form action="{{ oViewConf.getSslSelfLink()|raw }}" method="post"
              id="orderShipping">
            {{ oViewConf.getHiddenSid()|raw }}
            <input type="hidden" name="cl" value="payment">
            <input type="hidden" name="fnc" value="">
            <h4 class="card-header card-title card-header-edit d-flex justify-content-between align-items-center">
                {{ translate({ ident: "SHIPPING_CARRIER" }) }}
                <button type="submit" class="btn"
                        title="{{ translate({ ident: "EDIT" }) }}">
                    <svg aria-hidden="true">
                        <use xlink:href="#pencil"></use>
                    </svg>
                </button>
            </h4>
            {% set oShipSet = oView.getShipSet() %}
            <div class="card-body">
                {{ oShipSet.oxdeliveryset__oxtitle.value }}
            </div>
        </form>
        {# payment-base Sprint 06: with exactly one usable payment method there is
           nothing to confirm and nowhere for the pencil to lead — the payment step
           no longer offers a selection. This block replaces core's, so it has to
           honour the same decision itself instead of inheriting it.

           The `is defined` guard keeps the page alive if payment-base's OrderController
           extension is ever absent from the class chain: without it Twig would raise a
           runtime error here instead of simply showing the block. #}
        {% if oView.isSinglePaymentAutoAssigned is not defined
              or not oView.isSinglePaymentAutoAssigned() %}
            <form action="{{ oViewConf.getSslSelfLink()|raw }}" method="post"
                  id="orderPayment">
                {{ oViewConf.getHiddenSid()|raw }}
                <input type="hidden" name="cl" value="payment">
                <input type="hidden" name="fnc" value="">
                <h4 class="card-header card-title card-header-edit d-flex justify-content-between align-items-center">
                    {{ translate({ ident: "PAYMENT_METHOD" }) }}
                    <button type="submit" class="btn"
                            title="{{ translate({ ident: "EDIT" }) }}">
                        <svg aria-hidden="true">
                            <use xlink:href="#pencil"></use>
                        </svg>
                    </button>
                </h4>
                <div class="card-body">
                    {% set payment_id_template = paymentId|replace({'oe_payments_': ''}) %}
                    {% include [
                        "@oe_payments_stripe_wallet/frontend/" ~ payment_id_template ~ ".html.twig",
                        "@oe_payments_stripe_wallet/frontend/payment_method_unsupported.html.twig"]
                        with {
                        'payment': payment,
                        'oViewData': oViewData,
                        'oViewConf': oViewConf
                    } only %}
                </div>
            </form>
        {% endif %}
    {% endif %}
{% endblock %}

{% block checkout_order_next_step_side %}
    {% if payment.isStripePaymentMethod() == false %}
        {{ parent() }}
    {% else %}
        {% set displayBasketOrderButton = oViewConf.getViewThemeParam('basketLowOrderDisplayOrderButton') %}
        {% if not oView.isLowOrderPrice() or (displayBasketOrderButton == 'show' or displayBasketOrderButton == 'disabled') %}
            {% set createCheckoutSessionUrl = oViewConf.getSslSelfLink() ~ "cl=order&fnc=createCheckoutSession" %}
            {% set stripeIframe = oViewConf.isStripeIframeCheckout() %}
            {# IFRAME-02f: eager (button-less) embedded mount only when the iframe flag is on
               AND AGB does not gate the request. When AGB confirmation is required and not yet
               given, keep the button as the consent gate + trigger — eager-mounting there would
               400 on load (StripeOrderController::ensureAgbAccepted). #}
            {% set agbGating = oView.isConfirmAGBActive() and not oView.isPriorAgbConsent() %}
            {% set eagerIframe = stripeIframe and not agbGating %}
            {# CSRF token for AJAX requests (Sprint 64f: H8 frontend CSRF protection) #}
            <input type="hidden" name="stoken" value="{{ oViewConf.getSessionChallengeToken() }}" />
            {# Sprint 101: AGB validation Stimulus controller — resolves #checkAgbTop from apex
               via connect(); disabled if blConfirmAGB is off.
               IFRAME-02f: order-submit re-hosted here (was on the button) so the embedded sheet
               mounts without the button being painted first (kills the button→iframe flash). #}
            <div data-controller="agb-validation order-submit"
                 data-agb-validation-enabled-value="{{ oView.isConfirmAGBActive() ? 'true' : 'false' }}"
                 data-agb-validation-prior-consent-value="{{ oView.isPriorAgbConsent() ? 'true' : 'false' }}"
                 data-order-submit-url-value="{{ createCheckoutSessionUrl | raw }}"
                 data-order-submit-payment-type-value="wallet"
                 data-order-submit-publishable-key-value="{{ oViewConf.getStripePublishableKey() | raw }}"
                 data-order-submit-render-mode-value="{{ stripeIframe ? 'iframe' : 'redirect' }}"
                 data-order-submit-eager-value="{{ eagerIframe ? 'true' : 'false' }}"
                 data-order-submit-stripe-debug-value="{{ oViewConf.isStripeDebug() ? 'true' : 'false' }}">
                {# Place-Order button. In eager iframe mode it renders hidden and is revealed by
                   order-submit only if the eager mount cannot proceed (AGB / validation / error).
                   In redirect mode and AGB-gated iframe mode it is the visible trigger. #}
                <button id="stripe-checkout-btn"
                        type="button"
                        class="btn btn-highlight btn-lg w-100"
                        data-action="click->order-submit#handleSubmit"
                        data-order-submit-target="button"
                        data-agb-validation-target="submitButton"
                        {% if eagerIframe %}hidden{% endif %}
                        {% if oView.isLowOrderPrice() and displayBasketOrderButton == 'disabled' %}
                            disabled="disabled"
                        {% endif %}
                >
                    {{ translate({ ident: "SUBMIT_ORDER" }) }}
                </button>
                <div data-order-submit-target="status" class="mt-2 text-center"></div>
                {# IFRAME-02e/f: inline Stripe Embedded Checkout mount (used when render-mode=iframe) #}
                <div id="stripe-embedded-checkout" data-order-submit-target="embedded" class="stripe-embedded-checkout mt-3" style="display: none; min-height: 300px;"></div>
            </div>
        {% endif %}
    {% endif %}
{% endblock %}