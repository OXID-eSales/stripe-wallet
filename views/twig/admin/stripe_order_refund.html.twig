{# ============================================================================
   Stripe Order Refund Admin Template

   Controller: OxidSolutionCatalysts\Payments\Stripe\Controller\Admin\OrderRefund
   Controller Key: stripe_order_refund

   Available oView methods:
   - isStripeOrder(): bool - true if order paid with Stripe
   - wasRefundSuccessful(): ?bool - true after successful refund
   - getErrorMessage(): string|false - error message or false
   - isOrderRefundable(): bool - true if can be refunded
   - isFullRefundAvailable(): bool - true if no partial refunds made
   - getRemainingRefundableAmount(): string - formatted remaining amount
   - getFormatedPrice(float): string - formats price with currency
   - getOrder(): ?Order - the order object
   - hasStripeApiError(): bool - true if Stripe API call failed
   - getStripeApiError(): ?string - Stripe API error message
   ============================================================================ #}

<style>
    .refundTable TD {
        padding-top: 10px;
        padding-bottom: 10px;
    }
    TD.borderTop {
        border-top: 1px solid black!important;
    }
    FIELDSET {
        border-radius: 15px;
        margin-bottom: 20px;
        padding: 10px;
    }
    FIELDSET.fullRefund SPAN{
        margin-left: 2px;
    }
    FIELDSET .refundSubmit {
        margin-top: 15px;
    }
    .typeSelect {
        margin-bottom: 10px;
    }
    FIELDSET.refundError {
        background-color: #FF8282;
        color: black;
        border: 3px solid #F00000;
    }
    FIELDSET.refundNotice {
        background-color: #ffeeb5;
        border: 3px solid #FFE385;
    }
    FIELDSET.refundSuccess {
        background-color: #7aff9e;
        border: 3px solid #00b02f;
    }
    FIELDSET.message STRONG {
        display: block;
        margin-bottom: 10px;
    }
</style>

<form name="transfer" id="transfer" action="{{ oViewConf.getSelfLink() }}" method="post">
    {{ oViewConf.getHiddenSid()|raw }}
    <input type="hidden" name="oxid" value="{{ oxid }}">
    <input type="hidden" name="cl" value="stripe_order_refund">
</form>

{% if oView.isStripeOrder() == true %}
    {# Success Message #}
    {% if oView.wasRefundSuccessful() == true %}
        <fieldset class="refundSuccess message">
            {{ translate({ ident: "STRIPE_REFUND_SUCCESSFUL" }) }}
        </fieldset>
    {% endif %}

    {# Error Message #}
    {% if oView.getErrorMessage() != false %}
        <fieldset class="refundError message">
            <strong>Error</strong>
            {{ oView.getErrorMessage() }}
        </fieldset>
    {% endif %}

    {% set blIsOrderRefundable = oView.isOrderRefundable() %}

    {# Stripe API Error Notice (different from "already refunded") #}
    {% if oView.hasStripeApiError() %}
        <fieldset class="refundError message">
            <strong>{{ translate({ ident: "STRIPE_NOTICE" }) }}</strong>
            {{ translate({ ident: "STRIPE_API_ERROR" }) }}: {{ oView.getStripeApiError() }}
        </fieldset>
    {% elseif blIsOrderRefundable == false %}
        {# Order Already Refunded Notice #}
        <fieldset class="refundNotice message">
            <strong>{{ translate({ ident: "STRIPE_NOTICE" }) }}</strong>
            {{ translate({ ident: "STRIPE_ORDER_NOT_REFUNDABLE" }) }}
        </fieldset>
    {% endif %}

    {% set order = oView.getOrder() %}
    {% set edit = order %}
    <fieldset>
        <legend>{{ translate({ ident: "STRIPE_PAYMENT_DETAILS" }) }}</legend>
        <table>
            <tr>
                <td class="edittext">
                    {{ translate({ ident: "STRIPE_PAYMENT_TYPE" }) }}:
                </td>
                <td class="edittext">
                    {{ order.getFieldData('oxpaymenttype') }}
                </td>
                <td class="edittext"></td>
            </tr>
            <tr>
                <td class="edittext">
                    {{ translate({ ident: "STRIPE_TRANSACTION_ID" }) }}:
                </td>
                <td class="edittext">
                    {{ order.getFieldData('oxtransid') }}
                </td>
                <td class="edittext"></td>
            </tr>
            {% if order.getFieldData('stripeexternaltransid') %}
                <tr>
                    <td class="edittext">
                        {{ translate({ ident: "STRIPE_EXTERNAL_TRANSACTION_ID" }) }}:
                    </td>
                    <td class="edittext">
                        {{ order.getFieldData('stripeexternaltransid') }}
                    </td>
                    <td class="edittext"></td>
                </tr>
            {% endif %}
        </table>
    </fieldset>

    {# Full Refund Section - only show if order is refundable #}
    {% if blIsOrderRefundable == true %}
        <fieldset class="fullRefund">
            <legend>{{ translate({ ident: "STRIPE_FULL_REFUND" }) }}</legend>
            <form name="search" id="search" action="{{ oViewConf.getSelfLink() }}" method="post">
                {{ oViewConf.getHiddenSid()|raw }}
                <input type="hidden" name="cl" value="stripe_order_refund">
                <input type="hidden" name="oxid" value="{{ oxid }}">
                <input type="hidden" name="fnc" value="fullRefund">

                {% set blIsFullRefundAvailable = oView.isFullRefundAvailable() %}
                {% if blIsFullRefundAvailable == true %}
                    {# Use Stripe captured amount, not order total - they may differ due to discounts/vouchers #}
                    <span>{{ translate({ ident: "STRIPE_FULL_REFUND_TEXT" }) }}: {{ oView.getStripeCapturedAmount() }} <small>{{ edit.getFieldData('oxcurrency') }}</small></span><br><br>
                {% else %}
                    <input type="hidden" name="refundRemaining" value="1">
                    <span>{{ translate({ ident: "STRIPE_REFUND_REMAINING" }) }}: {{ oView.getRemainingRefundableAmount() }} <small>{{ edit.getFieldData('oxcurrency') }}</small></span><br><br>
                {% endif %}

                <span><label for="refund_reason">{{ translate({ ident: "STRIPE_REFUND_REASON" }) }}:</label></span>
                <select id="refund_reason" name="refund_reason">
                    <option value="">{{ translate({ ident: "STRIPE_PLEASE_SELECT" }) }}</option>
                    <option value="duplicate">{{ translate({ ident: "STRIPE_REFUND_DUPLICATE" }) }}</option>
                    <option value="requested_by_customer">{{ translate({ ident: "STRIPE_REFUND_CUSTOMER" }) }}</option>
                    <option value="fraudulent">{{ translate({ ident: "STRIPE_REFUND_FRAUD" }) }}</option>
                </select><br/>

                <span><label for="refund_description">{{ translate({ ident: "STRIPE_REFUND_DESCRIPTION" }) }}:</label></span>
                <input type="text" name="refund_description" value="" placeholder="{{ translate({ ident: "STRIPE_REFUND_DESCRIPTION_PLACEHOLDER" }) }}" maxlength="140" size="120"><br>

                <input type="submit" value="{{ translate({ ident: "STRIPE_REFUND_SUBMIT" }) }}" class="refundSubmit">
            </form>
        </fieldset>
    {% endif %}
{% endif %}
