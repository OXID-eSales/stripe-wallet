{#
    Stripe Buy Now Button Component
    Uses Stimulus.js controller for interaction
#}

{# CSS #}
<link rel="stylesheet" href="{{ oViewConf.getModuleUrl('osc_stripe_wallet', 'css/buy-now.css') }}">

{# Button HTML with Stimulus data attributes #}
<div class="buy-now-wrapper mt-3 mb-3"
     data-controller="buy-now"
     data-buy-now-product-id-value="{{ productId }}"
     data-buy-now-product-nid-value="{{ productNid }}"
     data-buy-now-parent-id-value="{{ parentId }}"
     data-buy-now-action-url-value="{{ oViewConf.getSelfActionLink()|raw }}"
     data-buy-now-csrf-token-value="{{ oViewConf.getSessionChallengeToken() }}">

    <button
        type="button"
        class="btn btn-success btn-lg w-100 stripe-buy-now"
        data-action="buy-now#submit"
        data-buy-now-target="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-lightning-charge-fill me-2" viewBox="0 0 16 16">
            <path d="M11.251.068a.5.5 0 0 1 .227.58L9.677 6.5H13a.5.5 0 0 1 .364.843l-8 8.5a.5.5 0 0 1-.842-.49L6.323 9.5H3a.5.5 0 0 1-.364-.843l8-8.5a.5.5 0 0 1 .615-.09z"/>
        </svg>
        {{ translate({ ident: "STRIPE_BUY_NOW" }) }}
    </button>

    <small class="text-muted d-block text-center mt-2">
        {{ translate({ ident: "STRIPE_BUY_NOW_HINT" }) }}
    </small>
</div>
