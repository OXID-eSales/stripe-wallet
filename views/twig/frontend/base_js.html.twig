{% if oViewConf.isStripeCheckoutActive() %}
    {# No Content-Security-Policy <meta> here (Sprint 137 S6): this block renders inside
       <body>, where browsers ignore a CSP meta and log an error on every page. SRI is
       not an option either — Stripe deploys js.stripe.com/v3 unpinned
       (github.com/stripe/stripe-js#167). A real CSP is shop-wide and belongs in the web
       server's HTTP headers; the merchant docs list the Stripe sources to allow. #}
    <script src="https://js.stripe.com/v3/"></script>
    {% set stripeJsPath = oViewConf.getStripeJsPath() %}
    {% set stripeVersion = oViewConf.getStripeModuleVersion() %}

    <script src="{{ oViewConf.getModuleUrl('oe_payments_stripe_wallet', stripeJsPath) }}?v={{ stripeVersion }}"></script>  

    {% include '@oe_payments_stripe_wallet/frontend/base_stripe_payment_controller_config.html.twig' %}
    {% include '@oe_payments_stripe_wallet/frontend/base_stripe_element_config.html.twig' %}
{% endif %}

