{#
 # One-Page Checkout with Stripe Integration
 #
 # This template extends the base one-page checkout template and injects
 # Stripe Payment Element UI into the payment provider slot.
 #
 # Architecture:
 # - Extends: @oe_onepage_checkout/frontend/checkout/checkout.html.twig
 # - Uses: Payment Provider UI Hook System
 # - Controller: onepage-stripe (Stimulus.js)
 # - EventBus: oe:payment:method-selected
 #
 # @see docs/PAYMENT_PROVIDER_UI_HOOK.md
 # @see resources/build/js/controllers/onepage_stripe_controller.js
 #}

{% extends "@oe_onepage_checkout/frontend/checkout/checkout.html.twig" %}

{% block payment_provider_ui %}
    {{ parent() }}

    {# Stripe Payment Element - Shows when Stripe payment method is selected #}
    {% include '@oe_payments_stripe_wallet/frontend/onepage-checkout-stripe-element.html.twig' %}
{% endblock %}
