{#
    Review Summary Component
    Final review before placing order
#}

<div class="review-summary">
    <p class="review-intro">
        {{ "CHECKOUT_REVIEW_INTRO"|translate }}
    </p>

    {# Shipping Address Review #}
    <div class="review-section">
        <div class="review-header">
            <h4>{{ "CHECKOUT_SHIPPING_TO"|translate }}</h4>
            <button type="button" class="btn-link edit-btn" data-edit="address">
                {{ "CHECKOUT_EDIT"|translate }}
            </button>
        </div>
        <div class="review-content" id="review-address">
            {# Filled by JavaScript after address submission #}
        </div>
    </div>

    {# Payment Method Review #}
    <div class="review-section">
        <div class="review-header">
            <h4>{{ "CHECKOUT_PAYMENT_METHOD"|translate }}</h4>
            <button type="button" class="btn-link edit-btn" data-edit="payment">
                {{ "CHECKOUT_EDIT"|translate }}
            </button>
        </div>
        <div class="review-content" id="review-payment">
            {# Filled by JavaScript after payment method selection #}
        </div>
    </div>

    {# Order Items Review #}
    <div class="review-section">
        <div class="review-header">
            <h4>{{ "CHECKOUT_ORDER_ITEMS"|translate }} ({{ oxcmp_basket.getProductsCount() }})</h4>
        </div>
        <div class="review-items">
            {% for item in oxcmp_basket.getContents() %}
                <div class="review-item">
                    <div class="item-image">
                        {% if item.getArticle().getThumbnailUrl() %}
                            <img
                                src="{{ item.getArticle().getThumbnailUrl() }}"
                                alt="{{ item.getTitle() }}"
                            >
                        {% endif %}
                    </div>
                    <div class="item-info">
                        <div class="item-title">{{ item.getTitle() }}</div>
                        <div class="item-quantity">{{ "CHECKOUT_QTY"|translate }}: {{ item.getAmount() }}</div>
                    </div>
                    <div class="item-price">
                        {{ item.getPrice().getBruttoPrice()|number_format(2, ',', '.') }}
                        {{ oxcmp_basket.getBasketCurrency().sign|raw }}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

    {# Final Confirmation #}
    <div class="review-section">
        <div class="review-total">
            <span class="total-label">{{ "CHECKOUT_TOTAL"|translate }}</span>
            <span class="total-amount">
                {{ oxcmp_basket.getPrice().getBruttoPrice()|number_format(2, ',', '.') }}
                {{ oxcmp_basket.getBasketCurrency().sign|raw }}
            </span>
        </div>
    </div>

    {# Place Order Button #}
    <div class="review-actions">
        <button
            type="button"
            class="btn btn-secondary"
            onclick="window.oxCheckout.goToStep('payment')"
        >
            <span class="btn-icon">←</span>
            {{ "CHECKOUT_BACK"|translate }}
        </button>

        <button
            type="button"
            class="btn btn-primary btn-large"
            id="place-order-btn"
            onclick="window.oxCheckout.placeOrder()"
        >
            <span class="lock-icon">🔒</span>
            {{ "CHECKOUT_PLACE_ORDER"|translate }}
        </button>
    </div>

    {# Legal Notice #}
    <div class="legal-notice">
        <small>
            {{ "CHECKOUT_LEGAL_NOTICE"|translate|raw }}
        </small>
    </div>
</div>
