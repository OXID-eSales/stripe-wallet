{#
    Cart Summary Component
    Displays order summary in sidebar
#}

<div class="cart-summary">
    <h3 class="summary-title">{{ "CHECKOUT_ORDER_SUMMARY"|translate }}</h3>

    {# Cart Items #}
    <div class="summary-items">
        {% for item in oxcmp_basket.getContents() %}
            <div class="summary-item">
                <div class="item-image">
                    {% if item.getArticle().getThumbnailUrl() %}
                        <img
                            src="{{ item.getArticle().getThumbnailUrl() }}"
                            alt="{{ item.getTitle() }}"
                            loading="lazy"
                        >
                    {% else %}
                        <div class="item-image-placeholder">
                            <span>{{ item.getTitle()|slice(0, 1) }}</span>
                        </div>
                    {% endif %}
                    {% if item.getAmount() > 1 %}
                        <span class="item-quantity-badge">{{ item.getAmount() }}</span>
                    {% endif %}
                </div>

                <div class="item-details">
                    <div class="item-title">{{ item.getTitle() }}</div>

                    {% if item.getArticle().oxarticles__oxartnum.value %}
                        <div class="item-artnum">
                            {{ "CHECKOUT_ARTICLE_NO"|translate }}: {{ item.getArticle().oxarticles__oxartnum.value }}
                        </div>
                    {% endif %}

                    {% if item.getSelList() %}
                        <div class="item-selections">
                            {% for selection in item.getSelList() %}
                                <small>{{ selection.name }}: {{ selection.value }}</small>
                            {% endfor %}
                        </div>
                    {% endif %}

                    <div class="item-quantity">
                        {{ "CHECKOUT_QUANTITY"|translate }}: {{ item.getAmount() }}
                    </div>
                </div>

                <div class="item-price">
                    {{ item.getPrice().getBruttoPrice()|number_format(2, ',', '.') }}
                    {{ oxcmp_basket.getBasketCurrency().sign|raw }}
                </div>
            </div>
        {% endfor %}
    </div>

    {# Price Breakdown #}
    <div class="summary-breakdown">
        {# Subtotal #}
        <div class="breakdown-row">
            <span>{{ "CHECKOUT_SUBTOTAL"|translate }}</span>
            <span>
                {{ oxcmp_basket.getProductsPrice().getBruttoPrice()|number_format(2, ',', '.') }}
                {{ oxcmp_basket.getBasketCurrency().sign|raw }}
            </span>
        </div>

        {# Discount #}
        {% if oxcmp_basket.getTotalDiscount() %}
            <div class="breakdown-row discount">
                <span>{{ "CHECKOUT_DISCOUNT"|translate }}</span>
                <span class="discount-amount">
                    -{{ oxcmp_basket.getTotalDiscount().getBruttoPrice()|number_format(2, ',', '.') }}
                    {{ oxcmp_basket.getBasketCurrency().sign|raw }}
                </span>
            </div>
        {% endif %}

        {# Shipping Cost #}
        {% set shippingCost = oxcmp_basket.getCosts('oxdelivery') %}
        {% if shippingCost %}
            <div class="breakdown-row">
                <span>
                    {{ "CHECKOUT_SHIPPING"|translate }}
                    {% if shippingCost.getBruttoPrice() == 0 %}
                        <span class="free-badge">{{ "CHECKOUT_FREE"|translate }}</span>
                    {% endif %}
                </span>
                <span>
                    {% if shippingCost.getBruttoPrice() > 0 %}
                        {{ shippingCost.getBruttoPrice()|number_format(2, ',', '.') }}
                        {{ oxcmp_basket.getBasketCurrency().sign|raw }}
                    {% else %}
                        {{ "CHECKOUT_FREE"|translate }}
                    {% endif %}
                </span>
            </div>
        {% endif %}

        {# Payment Cost #}
        {% set paymentCost = oxcmp_basket.getCosts('oxpayment') %}
        {% if paymentCost and paymentCost.getBruttoPrice() > 0 %}
            <div class="breakdown-row">
                <span>{{ "CHECKOUT_PAYMENT_COST"|translate }}</span>
                <span>
                    {{ paymentCost.getBruttoPrice()|number_format(2, ',', '.') }}
                    {{ oxcmp_basket.getBasketCurrency().sign|raw }}
                </span>
            </div>
        {% endif %}

        {# VAT #}
        {% if oxcmp_basket.getProductVats(false) %}
            {% for vat, vatPrice in oxcmp_basket.getProductVats(false) %}
                <div class="breakdown-row vat">
                    <span>{{ "CHECKOUT_VAT"|translate }} {{ vat }}%</span>
                    <span>
                        {{ vatPrice|number_format(2, ',', '.') }}
                        {{ oxcmp_basket.getBasketCurrency().sign|raw }}
                    </span>
                </div>
            {% endfor %}
        {% endif %}
    </div>

    {# Total #}
    <div class="summary-total">
        <div class="total-row">
            <span class="total-label">{{ "CHECKOUT_TOTAL"|translate }}</span>
            <span class="total-amount">
                {{ oxcmp_basket.getPrice().getBruttoPrice()|number_format(2, ',', '.') }}
                {{ oxcmp_basket.getBasketCurrency().sign|raw }}
            </span>
        </div>
        <div class="total-vat-info">
            {{ "CHECKOUT_INCL_VAT"|translate }}
        </div>
    </div>

    {# Voucher/Coupon Code #}
    <div class="voucher-section">
        <form id="voucher-form" class="voucher-form">
            <div class="voucher-input-group">
                <input
                    type="text"
                    name="voucherNr"
                    id="voucherNr"
                    class="form-input"
                    placeholder="{{ "CHECKOUT_COUPON_CODE"|translate }}"
                    value="{{ oxcmp_basket.getVoucherNr() }}"
                >
                <button type="submit" class="btn btn-secondary">
                    {{ "CHECKOUT_APPLY"|translate }}
                </button>
            </div>
        </form>

        {# Applied Vouchers #}
        {% if oxcmp_basket.getVouchers() %}
            <div class="applied-vouchers">
                {% for voucher in oxcmp_basket.getVouchers() %}
                    <div class="applied-voucher">
                        <span class="voucher-code">{{ voucher.sVoucherNr }}</span>
                        <span class="voucher-discount">
                            -{{ voucher.dVoucherdiscount|number_format(2, ',', '.') }}
                            {{ oxcmp_basket.getBasketCurrency().sign|raw }}
                        </span>
                        <button
                            type="button"
                            class="voucher-remove"
                            data-voucher="{{ voucher.sVoucherNr }}"
                            title="{{ "CHECKOUT_REMOVE_VOUCHER"|translate }}"
                        >×</button>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>

<script>
    // Voucher form handling
    document.getElementById('voucher-form').addEventListener('submit', async function(e) {
        e.preventDefault();

        const voucherInput = document.getElementById('voucherNr');
        const voucherCode = voucherInput.value.trim();

        if (!voucherCode) return;

        try {
            // Apply voucher via AJAX
            const response = await fetch('{{ oViewConf.getSelfLink() }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: new URLSearchParams({
                    cl: 'basket',
                    fnc: 'addVoucher',
                    voucherNr: voucherCode,
                    stoken: '{{ oViewConf.getSessionChallengeToken() }}'
                })
            });

            if (response.ok) {
                // Reload cart summary
                window.location.reload();
            }
        } catch (error) {
            console.error('Voucher application failed:', error);
        }
    });

    // Remove voucher handling
    document.querySelectorAll('.voucher-remove').forEach(btn => {
        btn.addEventListener('click', async function() {
            const voucherCode = this.dataset.voucher;

            try {
                const response = await fetch('{{ oViewConf.getSelfLink() }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: new URLSearchParams({
                        cl: 'basket',
                        fnc: 'removeVoucher',
                        voucherNr: voucherCode,
                        stoken: '{{ oViewConf.getSessionChallengeToken() }}'
                    })
                });

                if (response.ok) {
                    window.location.reload();
                }
            } catch (error) {
                console.error('Voucher removal failed:', error);
            }
        });
    });
</script>
