    OXTOTALORDERSUM : DECIMAL(20,2)
    OXCURRENCY : VARCHAR(32)
    OXSTORNO : TINYINT
    --
    <color:red>**NO NEW FIELDS ADDED**</color>
    ...40+ existing fields
  }

  entity "oxuser\n(Customers)" as USER {
    * **OXID** : CHAR(32) <<PK>>
    --
    OXSHOPID : INT
    OXUSERNAME : VARCHAR(255)
    OXFNAME : VARCHAR(255)
    OXLNAME : VARCHAR(255)
    OXEMAIL : VARCHAR(255)
    OXSTREET : VARCHAR(255)
