' Component Tables (NEW - Normalized Master-Detail Pattern)
package "Payment Component Tables (MASTER TABLE)" #LightGreen {
  entity "osc_payment_transaction\n(Master - Core Fields Only)" as PAYMENT_TX {
    * **OXID** : CHAR(32) <<PK>>
    --
    OXSHOPID : INT
    **OXORDERID** : CHAR(32) <<FK>>
    --
    <color:blue>**Provider Identification:**</color>
    **OXPROVIDER** : VARCHAR(32)
    **OXPROVIDERORDERID** : VARCHAR(128)
    **OXTRANSACTIONID** : VARCHAR(128)
    --
    <color:orange>**Transaction Basics:**</color>
    **OXTYPE** : VARCHAR(32)
    **OXSTATUS** : VARCHAR(32)
    **OXAMOUNT** : DECIMAL(10,2)
    **OXCURRENCY** : VARCHAR(3)
    --
    <color:purple>**Payment Method:**</color>
    OXPAYMENTMETHODID : VARCHAR(64)
    OXPAYMENTMETHODTYPE : VARCHAR(32)
    --
    <color:brown>**Relationships:**</color>
    OXPARENTTRANSACTIONID : CHAR(32) <<FK>>
    --
    <color:gray>**Metadata:**</color>
    OXCREATED : DATETIME
    OXUPDATED : DATETIME
    --
    <color:green>**Constraints:**</color>
    FK (OXORDERID) → oxorder.OXID
    FK (OXPARENTTRANSACTIONID) → OXID
    --
    **Row Size: ~250 bytes**
    **(6x smaller than old schema)**
  }
}

package "Payment Component Tables (DETAIL TABLES)" #LightBlue {
  entity "osc_payment_authorization_details\n(1:1 with transaction)" as AUTH_DETAILS {
    * **OXID** : CHAR(32) <<PK>>
    --
    **OXTRANSACTIONID** : CHAR(32) <<FK>> <<UNIQUE>>
    --
    <color:blue>**Authorization:**</color>
    OXAUTHORIZATIONID : VARCHAR(128)
    OXAUTHORIZEDAMOUNT : DECIMAL(10,2)
    OXCAPTUREDAMOUNT : DECIMAL(10,2)
    OXREMAININGAMOUNT : DECIMAL(10,2)
    --
    <color:orange>**Expiration (Computed):**</color>
    OXEXPIRESAT : DATETIME
    OXISEXPIRED : BOOLEAN <<COMPUTED>>
    --
    <color:purple>**Reauthorization:**</color>
    OXREAUTHCOUNT : INT
    OXMAXREAUTHCOUNT : INT
    OXCANREAUTHORIZE : BOOLEAN <<COMPUTED>>
    --
    <color:brown>**Strategy:**</color>
    OXCAPTURESTRATEGY : VARCHAR(32)
    --
    <color:gray>**Metadata:**</color>
    OXCREATED : DATETIME
    OXUPDATED : DATETIME
    --
    <color:green>**Constraints:**</color>
    FK (OXTRANSACTIONID) → osc_payment_transaction.OXID
    UNIQUE (OXTRANSACTIONID)
  }

  entity "osc_payment_3ds_details\n(1:1 with transaction)" as TDS_DETAILS {
    * **OXID** : CHAR(32) <<PK>>
    --
    **OXTRANSACTIONID** : CHAR(32) <<FK>> <<UNIQUE>>
    --
    <color:blue>**3DS Challenge:**</color>
    OXREQUIRESACTION : BOOLEAN
    OXACTIONTYPE : VARCHAR(32)
    OXACTIONURL : TEXT
    OXCHALLENGEDATA : TEXT
    --
    <color:orange>**Authentication:**</color>
    OXAUTHENTICATIONSTATUS : VARCHAR(32)
    OXLIABILITYSHIFTED : BOOLEAN
    OXAUTHENTICATIONVALUE : VARCHAR(128)
    OXAUTHENTICATIONID : VARCHAR(128)
    --
    <color:purple>**SCA:**</color>
    OXSCAMETHOD : VARCHAR(32)
    OXSCAEXEMPTION : VARCHAR(32)
    --
    <color:gray>**Metadata:**</color>
    OXCREATED : DATETIME
    OXUPDATED : DATETIME
    OXCOMPLETEDAT : DATETIME
    --
    <color:green>**Constraints:**</color>
    FK (OXTRANSACTIONID) → osc_payment_transaction.OXID
    UNIQUE (OXTRANSACTIONID)
  }

  entity "osc_payment_refund_details\n(1:1 with transaction)" as REFUND_DETAILS {
    * **OXID** : CHAR(32) <<PK>>
    --
    **OXTRANSACTIONID** : CHAR(32) <<FK>> <<UNIQUE>>
    --
    <color:blue>**Refund Calculation:**</color>
    OXORIGINALAMOUNT : DECIMAL(10,2)
    OXREFUNDAMOUNT : DECIMAL(10,2)
    OXTOTALREFUNDED : DECIMAL(10,2)
    OXREMAININGREFUNDABLE : DECIMAL(10,2)
    --
    <color:orange>**Provider Limits:**</color>
    OXMAXREFUNDAMOUNT : DECIMAL(10,2)
    OXCOMPENSATIONAMOUNT : DECIMAL(10,2)
    --
    <color:purple>**Reason:**</color>
    OXREASON : VARCHAR(64)
    OXREASONDETAILS : TEXT
    --
    <color:gray>**Metadata:**</color>
    OXCREATED : DATETIME
    OXPROCESSEDAT : DATETIME
    --
    <color:green>**Constraints:**</color>
    FK (OXTRANSACTIONID) → osc_payment_transaction.OXID
    UNIQUE (OXTRANSACTIONID)
  }

  entity "osc_payment_delivery_tracking\n(1:N with transaction)" as TRACKING {
    * **OXID** : CHAR(32) <<PK>>
    --
    **OXTRANSACTIONID** : CHAR(32) <<FK>>
    --
    <color:blue>**Tracking Info:**</color>
    OXTRACKINGCODE : VARCHAR(255)
    OXCARRIER : VARCHAR(64)
    OXCARRIERCODE : VARCHAR(32)
    OXTRACKINGURL : TEXT
    --
    <color:orange>**Shipment Status:**</color>
    OXSHIPMENTDATE : DATETIME
    OXDELIVERYDATE : DATETIME
    OXESTIMATEDDELIVERY : DATETIME
    OXSHIPMENTSTATUS : VARCHAR(32)
    --
    <color:purple>**Provider Notification:**</color>
    OXNOTIFIEDPROVIDER : BOOLEAN
    OXNOTIFICATIONDATE : DATETIME
    OXNOTIFICATIONSTATUS : VARCHAR(32)
    --
    <color:gray>**Metadata:**</color>
    OXCREATED : DATETIME
    OXUPDATED : DATETIME
    --
    <color:green>**Constraints:**</color>
    FK (OXTRANSACTIONID) → osc_payment_transaction.OXID
  }

  entity "osc_payment_provider_data\n(1:N with transaction)" as PROVIDER_DATA {
    * **OXID** : CHAR(32) <<PK>>
    --
    **OXTRANSACTIONID** : CHAR(32) <<FK>>
    --
    <color:blue>**Key-Value Storage:**</color>
    OXKEY : VARCHAR(128)
    OXVALUE : TEXT
    OXTYPE : VARCHAR(32)
    --
    <color:gray>**Metadata:**</color>
    OXCREATED : DATETIME
    OXUPDATED : DATETIME
    --
    <color:green>**Constraints:**</color>
    FK (OXTRANSACTIONID) → osc_payment_transaction.OXID
    UNIQUE (OXTRANSACTIONID, OXKEY)
  }
}

package "Payment Component Tables (SUPPORT TABLES)" #LightYellow {
  entity "osc_payment_order_state\n(Order Payment State)" as ORDER_STATE {
    * **OXID** : CHAR(32) <<PK>>
    --
    **OXORDERID** : CHAR(32) <<FK>> <<UNIQUE>>
    --
    <color:blue>**Payment Lifecycle:**</color>
    **OXPAYMENTSTATE** : VARCHAR(32)
    OXPROVIDERORDERID : VARCHAR(128)
    OXWEBHOOKWAITSINCE : DATETIME
    OXWEBHOOKTIMEOUT : INT
    OXLASTPAYMENTATTEMPT : DATETIME
    OXPAYMENTATTEMPTCOUNT : INT
    --
    <color:gray>**Metadata:**</color>
    OXCREATED : DATETIME
    OXUPDATED : DATETIME
    --
    <color:green>**Constraints:**</color>
    UNIQUE (OXORDERID)
    FK (OXORDERID) → oxorder.OXID
  }

  entity "osc_payment_customer\n(Payment Customer Data)" as PAYMENT_CUSTOMER {
    * **OXID** : CHAR(32) <<PK>>
    --
    **OXUSERID** : CHAR(32) <<FK>> <<UNIQUE>>
    --
    <color:blue>**Provider Integration:**</color>
    OXPAYMENTCUSTOMERID : VARCHAR(128)
    OXDEFAULTPAYMENTMETHOD : VARCHAR(64)
    OXSAVEDPAYMENTMETHODS : TEXT
    OXBILLINGAGREEMENT : BOOLEAN
    OXLASTPAYMENTDATE : DATETIME
    --
    <color:gray>**Metadata:**</color>
    OXCREATED : DATETIME
    OXUPDATED : DATETIME
    --
    <color:green>**Constraints:**</color>
    UNIQUE (OXUSERID)
    FK (OXUSERID) → oxuser.OXID
  }

  entity "osc_payment_idempotency\n(Duplicate Prevention)" as IDEMPOTENCY {
    * **OXID** : CHAR(32) <<PK>>
    --
    **OXKEY** : VARCHAR(128) <<UNIQUE>>
    **OXORDERID** : CHAR(32)
    **OXOPERATION** : VARCHAR(32)
    --
    <color:blue>**Cached Result:**</color>
    OXRESULT : TEXT
    OXSTATUS : VARCHAR(32)
    --
    <color:orange>**Expiration:**</color>
    OXCREATED : DATETIME
    OXEXPIRES : DATETIME
