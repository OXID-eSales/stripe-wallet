    OXUSERID : CHAR(32) <<FK>>
    OXORDERDATE : DATETIME
    OXORDERNR : INT
    OXBILLEMAIL : VARCHAR(255)
    OXBILLFNAME : VARCHAR(255)
    OXBILLLNAME : VARCHAR(255)
    OXTRANSSTATUS : VARCHAR(32)
