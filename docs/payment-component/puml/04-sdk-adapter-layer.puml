' Business Logic (Payment Component)
package "Payment Component (Business Logic)" <<Rectangle>> #C8E6C9 {

  class PaymentService {
    - adapter: PaymentAdapterInterface
    - transactionRepo: PaymentTransactionRepository
    - orderStateRepo: PaymentOrderStateRepository
    - eventDispatcher: EventDispatcherInterface
    --
    + initiatePayment(order, method): PaymentResponse
    + capturePayment(order): CaptureResponse
    + refundPayment(order, amount): RefundResponse
    --
    **Provider-Agnostic**
    Uses adapter interface
  }
}

