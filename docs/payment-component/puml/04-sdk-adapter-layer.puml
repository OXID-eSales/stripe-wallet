' Provider Adapters
package "Provider Adapters (Provider-Specific)" <<Rectangle>> #FFEBEE {

  class StripeAdapter implements PaymentAdapterInterface {
    - client: StripeClient
    - apiKey: string
    - sandbox: bool
    --
    + __construct(apiKey, sandbox)
    + createPayment(request): PaymentResponse
    + capturePayment(request): CaptureResponse
    + refundPayment(request): RefundResponse
    + voidPayment(request): VoidResponse
    + getPaymentDetails(id): PaymentDetailsResponse
    + parseWebhook(payload, sig, secret): WebhookEvent
    + getSupportedPaymentMethods(): array
    + getProviderName(): string
    + supportsFeature(feature): bool
    --
    - convertAmountToCents(amount): int
    - convertCentsToAmount(cents): float
    - mapStripeStatus(status): string
    - mapPaymentMethod(method): array
    - mapRefundReason(reason): ?string
    --
    **Provider-Specific**
    Stripe SDK integration
  }

  class UnzerAdapter implements PaymentAdapterInterface {
    - client: Unzer
    - privateKey: string
    - sandbox: bool
    --
    + __construct(privateKey, sandbox)
    + createPayment(request): PaymentResponse
    + capturePayment(request): CaptureResponse
    + refundPayment(request): RefundResponse
    + getSupportedPaymentMethods(): array
    + getProviderName(): string
    + supportsFeature(feature): bool
    --
    - mapUnzerStatus(status): string
    - createOrGetCustomer(request): Customer
    - createBasket(request): Basket
    --
    **Provider-Specific**
    Unzer SDK integration
  }

  class PayPalAdapter implements PaymentAdapterInterface {
    - client: PayPalHttpClient
    - clientId: string
    - clientSecret: string
    - sandbox: bool
    --
    + __construct(clientId, clientSecret, sandbox)
    + createPayment(request): PaymentResponse
    + capturePayment(request): CaptureResponse
    + refundPayment(request): RefundResponse
    + getSupportedPaymentMethods(): array
    + getProviderName(): string
    + supportsFeature(feature): bool
    --
    - mapPayPalStatus(status): string
    - buildPurchaseUnits(request): array
    --
    **Provider-Specific**
    PayPal SDK integration
  }

  class AdyenAdapter implements PaymentAdapterInterface {
    - client: AdyenClient
    - apiKey: string
    - merchantAccount: string
    - sandbox: bool
    --
    + __construct(apiKey, merchantAccount, sandbox)
    + createPayment(request): PaymentResponse
    + capturePayment(request): CaptureResponse
    + getSupportedPaymentMethods(): array
    + getProviderName(): string
    --
    **Provider-Specific**
    Adyen SDK integration
  }
}

' Exception Handling
package "Exception Handling (100% Reusable)" <<Rectangle>> #FCE4EC {

  class PaymentAdapterException extends RuntimeException {
    - errorCode: string
    - provider: ?string
    --
    + __construct(message, errorCode, provider, previous)
    + {static} fromProviderError(provider, message, code, previous): self
    + getErrorCode(): string
    + getProvider(): ?string
    + isCardDeclined(): bool
    + isAuthenticationRequired(): bool
    + isNetworkError(): bool
    --
    **100% Reusable**
    Unified error handling
  }

  class CardDeclinedException extends PaymentAdapterException {
    + __construct(message, provider, previous)
    --
    Specific: Card declined
  }

  class AuthenticationRequiredException extends PaymentAdapterException {
    + __construct(message, provider, previous)
    --
    Specific: 3DS required
  }

  class NetworkException extends PaymentAdapterException {
    + __construct(message, provider, previous)
    --
    Specific: Network error
  }
}

' Factory
package "Factory (100% Reusable)" <<Rectangle>> #F3E5F5 {

  class AdapterFactory {
    - settings: ModuleSettings
