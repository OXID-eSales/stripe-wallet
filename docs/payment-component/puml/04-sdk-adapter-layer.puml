title SDK-Adapter Layer Architecture\\n(Provider-Agnostic Payment Integration)

' Adapter Interface
package "Adapter Interface (100% Reusable)" <<Rectangle>> #E8F5E9 {

  interface PaymentAdapterInterface {
    + createPayment(CreatePaymentRequest): PaymentResponse
    + capturePayment(CapturePaymentRequest): CaptureResponse
    + refundPayment(RefundPaymentRequest): RefundResponse
    + voidPayment(VoidPaymentRequest): VoidResponse
    + getPaymentDetails(providerPaymentId): PaymentDetailsResponse
    + getSupportedPaymentMethods(): array
    + parseWebhook(payload, signature, secret): WebhookEvent
    + getProviderName(): string
    + supportsFeature(feature): bool
    --
    **100% Reusable**
    Contract for all providers
  }

  interface WebhookEvent {
    + getEventType(): string
    + getProviderPaymentId(): string
    + getData(): array
    + getTimestamp(): DateTimeImmutable
    + isPaymentSuccess(): bool
    + isPaymentFailure(): bool
    + isRefund(): bool
  }
}

' Request Objects
package "Request Objects (100% Reusable)" <<Rectangle>> #E3F2FD {

  class CreatePaymentRequest {
    - amount: float
    - currency: string
    - orderId: string
    - shopId: string
    - paymentMethod: string
    - directCapture: bool
    - paymentMethodId: ?string
    - customerId: ?string
    - returnUrl: ?string
    - cancelUrl: ?string
    - metadata: array
    --
    + __construct(...)
    + getAmount(): float
    + getCurrency(): string
    + getOrderId(): string
    + isDirectCapture(): bool
    + getPaymentMethodId(): ?string
    --
    **100% Reusable**
    Provider-agnostic request
  }

  class CapturePaymentRequest {
    - providerPaymentId: string
    - amount: float
    - metadata: array
    --
    + getProviderPaymentId(): string
    + getAmount(): float
    + getMetadata(): array
    --
    **100% Reusable**
  }

  class RefundPaymentRequest {
    - providerPaymentId: string
    - amount: float
    - reason: ?string
    - metadata: array
    --
    + getProviderPaymentId(): string
    + getAmount(): float
    + getReason(): ?string
    --
    **100% Reusable**
  }

  class VoidPaymentRequest {
    - providerPaymentId: string
    - reason: ?string
    --
    + getProviderPaymentId(): string
    + getReason(): ?string
    --
    **100% Reusable**
  }
}

