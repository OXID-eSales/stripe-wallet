    + __construct(settings)
    + createAdapter(providerName): PaymentAdapterInterface
    + createDefaultAdapter(): PaymentAdapterInterface
    --
    - createStripeAdapter(): StripeAdapter
    - createUnzerAdapter(): UnzerAdapter
    - createPayPalAdapter(): PayPalAdapter
    - createAdyenAdapter(): AdyenAdapter
    --
    **100% Reusable**
    Configuration-driven creation
  }
}

