' Phase 2: GREEN
package "Phase 2: GREEN - Implement Contract-Aware Logic" #C8E6C9 {
    rectangle "Refactor WebhookProcessingService" as Green1 #A5D6A7 {
        note as G1Note
          <code>
          class WebhookProcessingService
          {
              public function __construct(
                  private ContractRepositoryInterface $contractRepo,
                  private EventDispatcherInterface $dispatcher,
                  private WebhookLogRepositoryInterface $logRepo
              ) {}

              private function handlePaymentIntentSucceeded(Event $event): void
              {
                  $pi = $event->data->object;

                  // 1. Find Contract (not order!)
                  $contract = $this->contractRepo->findByProviderOrderId($pi->id);

                  // 2. Validate state
                  if ($contract->getState()->isFulfilled()) {
                      return; // Idempotent
                  }
                  if (!$contract->getState()->isCommitted()) {
                      throw new InvalidStateException();
                  }

                  // 3. Fulfill contract
                  $contract->fulfill();
                  $this->contractRepo->save($contract);

                  // 4. Update order THROUGH contract
                  $this->updateOrderFromContract($contract);

                  // 5. Dispatch event
                  $this->dispatcher->dispatch(
                      new ContractFulfilledEvent($contract)
                  );
              }
          }
          </code>
        end note
    }
}

