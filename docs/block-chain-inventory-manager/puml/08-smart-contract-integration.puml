@startuml Smart Contract Integration - Payment Component + Inventory System

' South Park Inspired Color Palette
' Bold, bright, flat colors with high saturation
skinparam backgroundColor #87CEEB
skinparam shadowing false
skinparam sequenceArrowThickness 2
skinparam roundcorner 5
skinparam ParticipantFontSize 10
skinparam ParticipantFontStyle bold
skinparam maxmessagesize 250

title Smart Contract Integration

' ============================================
' Participants
' ============================================

actor "<color:#000000><b>Customer</b></color>" as Customer #FFC0CB
participant "<color:white><b>Checkout Controller</b></color>" as Controller #0066CC
participant "<color:white><b>Payment Component</b></color>" as Payment #0033AA
box "<color:white><b>Payment Contract Lifecycle</b></color>" #3366CC
    participant "<color:white><b>Contract Repository</b></color>" as ContractRepo #0066CC
    participant "<color:white><b>Payment Contract</b></color>" as Contract #6699FF
end box
participant "<color:white><b>Event Dispatcher</b></color>" as EventBus #9933CC
box "<color:white><b>Inventory Management System</b></color>" #CC6600
    participant "<color:white><b>ReserveStock Handler</b></color>" as ReserveHandler #FF8800
    participant "<color:white><b>ReleaseStock Handler</b></color>" as ReleaseHandler #FF9900
    participant "<color:white><b>CommitStock Handler</b></color>" as CommitHandler #FFAA00
    participant "<color:white><b>Inventory Service</b></color>" as InventoryService #CC5500
end box
participant "<color:white><b>Raft Consensus</b></color>" as Raft #CC0000
participant "<color:white><b>Inventory Ledger</b></color>" as Ledger #6600CC
database "<color:white><b>MySQL</b></color>" as DB #333333

' ============================================
' Phase 1: Contract Creation
' ============================================

== <color:#0033AA><b>Phase 1: Contract Creation</b></color> ==

Customer -> Controller : Click "Place Order"
activate Controller #99CCFF

Controller -> Payment : createContract(basket, user)
activate Payment #CCE5FF

Payment -> Contract : new PaymentContract(...)
activate Contract #99CCFF

Contract -> Contract : state = DRAFT, Add basket snapshot

Payment -> ContractRepo : save(contract)
activate ContractRepo #99CCFF
ContractRepo -> DB : INSERT INTO osc_payment_contract
DB --> ContractRepo : OK
ContractRepo --> Payment : contract_id
deactivate ContractRepo

Payment -> EventBus : dispatch(ContractCreatedEvent)
activate EventBus #CC99FF

note right of EventBus #F5E6FF
  <b><color:#9933CC>Event Dispatched</color></b>
  ━━━━━━━━━━━━━━━━━━
  <b>Event:</b> ContractCreatedEvent
  <b>Payload:</b> contractId, userId
  <b>Subscribers:</b>
  • AddStockConditionHandler
end note

EventBus -> ReserveHandler : handle(ContractCreatedEvent)
activate ReserveHandler #FFCC99

ReserveHandler -> Contract : addCondition(TYPE_STOCK_RESERVED)

note right of Contract #E6F2FF
  <b><color:#0033AA>Contract Conditions</color></b>
  ━━━━━━━━━━━━━━━━━━━━
  1. PAYMENT_AUTHORIZED ⏳
  2. STOCK_RESERVED ⏳
  3. FRAUD_CHECK ⏳
end note

Contract -> Contract : state = PENDING
ReserveHandler -> ContractRepo : save(contract)
activate ContractRepo #99CCFF
ContractRepo -> DB : UPDATE osc_payment_contract
deactivate ContractRepo
deactivate ReserveHandler

EventBus --> Payment : OK
deactivate EventBus

Payment --> Controller : contract_id
deactivate Payment
deactivate Contract

Controller --> Customer : Redirect to payment
deactivate Controller

' ============================================
' Phase 2: Payment Authorization
' ============================================

== <color:#00AA00><b>Phase 2: Payment Authorization</b></color> ==

Customer -> Payment : Authorize payment (Stripe/PayPal)
activate Payment #CCE5FF

Payment -> Contract : fulfillCondition(PAYMENT_AUTHORIZED)
activate Contract #99CCFF
Contract -> Contract : Mark condition fulfilled
deactivate Contract

Payment -> EventBus : dispatch(PaymentAuthorizedEvent)
activate EventBus #CC99FF

note right of EventBus #E6FFE6
  <b><color:#00AA00>Critical Event</color></b>
  ━━━━━━━━━━━━━━━━━━
  <b>Event:</b> PaymentAuthorizedEvent
  <b>Triggers:</b> Stock reservation
  <b>Timeout:</b> 5 minutes
end note

EventBus -> ReserveHandler : handle(PaymentAuthorizedEvent)
activate ReserveHandler #FFCC99

ReserveHandler -> ContractRepo : find(contractId)
activate ContractRepo #99CCFF
ContractRepo --> ReserveHandler : PaymentContract
deactivate ContractRepo

ReserveHandler -> InventoryService : reserveStock(contract)
activate InventoryService #FFDD99

note right of InventoryService #FFE6CC
  <b><color:#CC5500>Inventory Operations</color></b>
  ━━━━━━━━━━━━━━━━━━━━━━━
  1. Extract items from basket
  2. Find optimal warehouse (distance)
  3. Reserve via Raft consensus
  4. Append to immutable ledger
  5. Update cache (Redis)
end note

loop <color:#CC5500><b>For each item in basket</b></color>

    InventoryService -> InventoryService : findOptimalWarehouse(SKU)

    InventoryService -> Raft : reserveStock(SKU, qty, warehouse)
    activate Raft #FF9999

    note right of Raft #FFE6E6
      <b><color:#CC0000>Raft Consensus</color></b>
      ━━━━━━━━━━━━━━━━━━
      • Leader serializes request
      • Replicate to followers
      • Quorum (2/3) achieved
      • Commit reservation

      <b>Result:</b> Linearizability ✓
      <b>Guarantee:</b> No overselling ✓
    end note

    Raft -> Ledger : append(STOCK_RESERVED)
    activate Ledger #CC99FF

    Ledger -> Ledger : Calculate hash chain SHA-256(event + prevHash)

    Ledger -> DB : INSERT INTO osc_inventory_ledger
    activate DB #999999
    DB --> Ledger : event_id
    deactivate DB

    Ledger --> Raft : OK
    deactivate Ledger

    Raft --> InventoryService : reservation_id
    deactivate Raft

    InventoryService -> DB : INSERT INTO osc_inventory_reservation
    activate DB #999999
    InventoryService -> DB : UPDATE osc_inventory_stock_level SET available -= qty, reserved += qty
    DB --> InventoryService : OK
    deactivate DB

end

InventoryService --> ReserveHandler : StockReservation[]
deactivate InventoryService

ReserveHandler -> Contract : fulfillCondition(TYPE_STOCK_RESERVED, reservation_ids)
activate Contract #99CCFF

Contract -> Contract : All conditions met? state = READY_TO_COMMIT

note right of Contract #CCFFCC
  <b><color:#00AA00>All Conditions Met ✓</color></b>
  ━━━━━━━━━━━━━━━━━━━━━━━
  1. PAYMENT_AUTHORIZED ✅
  2. STOCK_RESERVED ✅
  3. FRAUD_CHECK ✅

  → <b>Contract READY_TO_COMMIT</b>
end note

deactivate Contract

ReserveHandler -> ContractRepo : save(contract)
activate ContractRepo #99CCFF
ContractRepo -> DB : UPDATE osc_payment_contract SET OXSTATE='ready_to_commit'
deactivate ContractRepo

ReserveHandler --> EventBus : Success
deactivate ReserveHandler

EventBus --> Payment : OK
deactivate EventBus

Payment --> Customer : Payment successful
deactivate Payment

' ============================================
' Phase 3: Order Creation
' ============================================

== <color:#0066CC><b>Phase 3: Order Creation</b></color> ==

Payment -> Payment : commitContract(contract)
activate Payment #CCE5FF

Payment -> DB : INSERT INTO oxorder
activate DB #999999
DB --> Payment : order_id
deactivate DB

Payment -> Contract : commitToOrder(order_id)
activate Contract #99CCFF
Contract -> Contract : state = COMMITTED, orderId = order_id
deactivate Contract

Payment -> EventBus : dispatch(OrderCreatedEvent)
activate EventBus #CC99FF

EventBus -> CommitHandler : handle(OrderCreatedEvent)
activate CommitHandler #FFCC99

CommitHandler -> InventoryService : commitStock(contract, order_id)
activate InventoryService #FFDD99

note right of InventoryService #FFE6CC
  <b><color:#CC5500>Commit Stock</color></b>
  ━━━━━━━━━━━━━━━━━━
  Move stock:
  <b>reserved → committed</b>

  Permanent allocation to order
end note

InventoryService -> DB : UPDATE osc_inventory_reservation SET OXSTATE='committed', OXORDERID=:orderId
activate DB #999999
InventoryService -> DB : UPDATE osc_inventory_stock_level SET reserved -= qty, committed += qty
DB --> InventoryService : OK
deactivate DB

InventoryService -> Ledger : append(STOCK_COMMITTED)
activate Ledger #CC99FF
Ledger -> DB : INSERT INTO osc_inventory_ledger
activate DB #999999
deactivate DB
deactivate Ledger

InventoryService --> CommitHandler : OK
deactivate InventoryService

CommitHandler --> EventBus : OK
deactivate CommitHandler

EventBus --> Payment : OK
deactivate EventBus

Payment --> Customer : Order confirmed
deactivate Payment

' ============================================
' Phase 4: Payment Failure (Alternative Flow)
' ============================================

== <color:#CC0000><b>Alternative: Payment Failed</b></color> ==

Customer -> Payment : Payment authorization fails
activate Payment #FFCCCC

Payment -> EventBus : dispatch(PaymentFailedEvent)
activate EventBus #CC99FF

EventBus -> ReleaseHandler : handle(PaymentFailedEvent)
activate ReleaseHandler #FFCC99

note right of ReleaseHandler #FFE6E6
  <b><color:#CC0000>Automatic Rollback</color></b>
  ━━━━━━━━━━━━━━━━━━━━━
  Release reserved stock
  Return to available pool

  <b>Idempotent:</b> Safe to retry ✓
end note

ReleaseHandler -> InventoryService : releaseStock(contract)
activate InventoryService #FFDD99

InventoryService -> DB : UPDATE osc_inventory_reservation SET OXSTATE='released'
activate DB #999999
InventoryService -> DB : UPDATE osc_inventory_stock_level SET reserved -= qty, available += qty
DB --> InventoryService : OK
deactivate DB

InventoryService -> Ledger : append(STOCK_RELEASED)
activate Ledger #CC99FF
Ledger -> DB : INSERT INTO osc_inventory_ledger
activate DB #999999
deactivate DB
deactivate Ledger

InventoryService --> ReleaseHandler : OK
deactivate InventoryService

ReleaseHandler -> Contract : failCondition(TYPE_STOCK_RESERVED)
activate Contract #99CCFF
Contract -> Contract : state = FAILED
deactivate Contract

ReleaseHandler --> EventBus : OK
deactivate ReleaseHandler

EventBus --> Payment : OK
deactivate EventBus

Payment --> Customer : Payment failed, stock released
deactivate Payment

' ============================================
' Summary Box
' ============================================

note over Customer, Ledger #FFFFCC
  <size:14><b><color:#000000>Integration Benefits</color></b></size>
  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  ✅ <b>Atomic Operations:</b> Payment + Stock reservation happen together
  ✅ <b>Automatic Rollback:</b> Failed payments release stock immediately
  ✅ <b>Event-Driven:</b> No tight coupling between components
  ✅ <b>Linearizability:</b> Raft consensus prevents race conditions
  ✅ <b>Complete Audit:</b> Immutable ledger records all operations
  ✅ <b>No Manual Work:</b> Fully automated workflow
end note

' ============================================
' Legend
' ============================================

legend right
  <size:14><b>Integration Architecture</b></size>
  <size:10><i>South Park inspired bold palette</i></size>
  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  |<back:#0033AA><color:white>     </color></back>| <b>Payment Component</b> | Contract lifecycle manager |
  |<back:#CC6600><color:white>     </color></back>| <b>Inventory System</b> | Event-driven handlers |
  |<back:#9933CC><color:white>     </color></back>| <b>Event Dispatcher</b> | PSR-14 event bus |
  |<back:#CC0000><color:white>     </color></back>| <b>Raft Consensus</b> | Prevents overselling |
  |<back:#6600CC><color:white>     </color></back>| <b>Inventory Ledger</b> | Immutable audit log |

  <size:11><b>Event Flow:</b></size>
  <b>1.</b> ContractCreatedEvent → Add stock condition
  <b>2.</b> PaymentAuthorizedEvent → Reserve stock (Raft)
  <b>3.</b> OrderCreatedEvent → Commit stock
  <b>4.</b> PaymentFailedEvent → Release stock (rollback)

  <size:11><b>Integration Patterns:</b></size>
  • Smart Contract Conditions
  • Event-Driven Architecture
  • Saga Pattern (distributed transactions)
  • CQRS (separate read/write paths)
endlegend

@enduml
