@startuml Stock Reservation Sequence

' Professional Color Palette
skinparam backgroundColor #FAFAFA
skinparam shadowing false
skinparam sequenceArrowThickness 2
skinparam roundcorner 10
skinparam maxmessagesize 200
skinparam ParticipantFontSize 11
skinparam ParticipantFontStyle bold

title <size:18><color:#0D47A1><b>Stock Reservation Flow</b></color></size> <size:12><color:#424242>Payment Authorization → Stock Reserved</color></size>

' Participants with professional colors
participant "<color:white><b>Payment Component</b></color>" as Payment #1976D2
participant "<color:white><b>ReserveStock Handler</b></color>" as Handler #E65100
participant "<color:white><b>Inventory Service</b></color>" as Service #7B1FA2
participant "<color:white><b>Warehouse Allocator</b></color>" as Allocator #7B1FA2
participant "<color:white><b>Inventory Item</b></color>" as Item #BF360C
participant "<color:white><b>Raft Leader</b></color>" as Leader #B71C1C
participant "<color:white><b>Inventory Ledger</b></color>" as Ledger #4A148C
participant "<color:white><b>Event Store</b></color>" as EventStore #311B92
participant "<color:white><b>Redis Cache</b></color>" as Cache #C62828
participant "<color:white><b>Contract Repository</b></color>" as ContractRepo #1565C0

== Payment Authorization ==

Payment -> Handler : <b>PaymentAuthorizedEvent</b> contractId: "ctr_123"
activate Handler #FFE0B2
note right of Payment #E3F2FD
  <b><color:#0D47A1>Trigger</color></b>
  ━━━━━━━━━━━━
  User's payment authorized
  by Stripe/PayPal/etc.

  <b>Contract conditions:</b>
  ✅ PAYMENT_AUTHORIZED
  ⏳ STOCK_RESERVED
end note

Handler -> ContractRepo : getContract("ctr_123")
activate ContractRepo #BBDEFB
ContractRepo --> Handler : PaymentContract
deactivate ContractRepo

Handler -> Service : <b>reserveStock(contract)</b>
activate Service #F3E5F5

== Warehouse Selection ==

Service -> Service : Extract items from basket snapshot
note right of Service #FFF8E1
  <b><color:#F57C00>Items</color></b>
  ━━━━━━━━━━━━
  • SKU: IPHONE-15, qty: 1
  • SKU: MACBOOK-PRO, qty: 1
end note

loop <color:#7B1FA2><b>For each item</b></color>

    Service -> Allocator : <b>findOptimal</b>(SKU, quantity, address)
    activate Allocator #E1BEE7

    Allocator -> Allocator : Calculate scores: • Distance • Load • Cost
    note right of Allocator #F1F8E9
      <b><color:#2E7D32>Score Calculation</color></b>
      ━━━━━━━━━━━━━━━━━━━━
      NY:  dist=10km, load=30% → <b>score=12</b>
      LA:  dist=4000km, load=20% → score=4020
      → <b>Select NY warehouse</b> ✓
    end note

    Allocator --> Service : Warehouse (NY)
    deactivate Allocator

end

== Consensus-Based Reservation ==

Service -> Item : <b>reserve</b>(quantity, warehouse, contractId, expiresAt)
activate Item #FFECB3

Item -> Item : Check availability
note right of Item #FFF3E0
  <b><color:#BF360C>Business Rules</color></b>
  ━━━━━━━━━━━━━━━━━━━
  ✅ Stock available >= quantity
  ✅ Warehouse operational
  ✅ No duplicate reservation
end note

alt <color:#2E7D32><b>Stock Available</b></color>

    Item -> Leader : <b>Request: Reserve stock</b> (SKU, qty, warehouse, contract)
    activate Leader #FFCDD2

    note right of Leader #FFEBEE
      <b><color:#B71C1C>Raft Consensus</color></b>
      ━━━━━━━━━━━━━━━━━━
      Leader serializes requests
      → No race conditions
      → Linearizability
    end note

    Leader -> Leader : Append to log (Index: 12345)
    Leader -> Leader : Replicate to followers (wait for quorum)

    Leader --> Item : <b>Approved</b> reservationId: "res_abc"
    deactivate Leader

    Item -> Item : Create StockReservation Update StockLevel
    Item -> Item : <b>Emit: StockReservedEvent</b>

    Item -> Ledger : <b>append(StockReservedEvent)</b>
    activate Ledger #E1BEE7

    Ledger -> Ledger : Calculate hash: SHA-256(eventId + data + prevHash)
    note right of Ledger #E8F5E9
      <b><color:#1B5E20>Hash Chain</color></b>
      ━━━━━━━━━━━━━━━━
      Event 12345:
      hash: b4f3e2...
      prevHash: a3f2e1...
      → Immutable audit trail
    end note

    Ledger -> EventStore : <b>Persist event</b>
    activate EventStore #C5CAE9
    EventStore --> Ledger : OK
    deactivate EventStore

    Ledger --> Item : OK
    deactivate Ledger

    Item -> Cache : <b>DECRBY</b> stock:available:{SKU} {qty}
    activate Cache #FFCDD2
    Cache --> Item : New value: 99
    deactivate Cache

    Item --> Service : StockReservation
    deactivate Item

else <color:#C62828><b>Insufficient Stock</b></color>

    Item --> Service : ❌ <b>InsufficientStockException</b>
    note right of Item #FFEBEE
      <b><color:#B71C1C>Failure Scenarios</color></b>
      ━━━━━━━━━━━━━━━━━━━━━
      ❌ Stock unavailable
      ❌ Warehouse offline
      ❌ Duplicate reservation
    end note

    Service --> Handler : Exception
    Handler -> Handler : Log error
    Handler -> ContractRepo : contract.failCondition( 'STOCK_RESERVED')
    Handler --> Payment : ❌ Stock unavailable

end

== Update Contract ==

Service --> Handler : StockReservation[]
deactivate Service

Handler -> ContractRepo : <b>contract.fulfillCondition</b>( 'TYPE_STOCK_RESERVED')
activate ContractRepo #BBDEFB

ContractRepo -> ContractRepo : Update contract state: PENDING → READY_TO_COMMIT
note right of ContractRepo #E3F2FD
  <b><color:#1565C0>Contract Conditions</color></b>
  ━━━━━━━━━━━━━━━━━━━━━━━
  ✅ PAYMENT_AUTHORIZED
  ✅ STOCK_RESERVED
  ✅ FRAUD_CHECK
  → All conditions met
  → <b>Contract READY_TO_COMMIT</b>
end note

ContractRepo --> Handler : OK
deactivate ContractRepo

Handler --> Payment : ✅ <b>Stock reserved successfully</b>
deactivate Handler

== Result ==

note over Payment, Cache #E8F5E9
  <b><size:13><color:#1B5E20>Outcome</color></size></b>
  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  ✓ Stock reserved in warehouse
  ✓ Reservation expires in 5 minutes
  ✓ Contract condition fulfilled
  ✓ Event appended to immutable ledger
  ✓ Cache updated (5-10ms queries)
  ✓ Contract ready to commit → Order creation
end note

legend right
  <size:13><b>Color Legend</b></size>
  ━━━━━━━━━━━━━━━━━━━
  |<back:#1976D2>     </back>| <b>Payment</b> | External payment system |
  |<back:#E65100>     </back>| <b>Handler</b> | Event handler (application) |
  |<back:#7B1FA2>     </back>| <b>Service</b> | Domain service |
  |<back:#BF360C>     </back>| <b>Aggregate</b> | Domain aggregate root |
  |<back:#B71C1C>     </back>| <b>Consensus</b> | Raft leader (blockchain) |
  |<back:#4A148C>     </back>| <b>Ledger</b> | Event store (immutable) |
  |<back:#C62828>     </back>| <b>Cache</b> | Redis cache layer |
endlegend

@enduml
