@startuml Blockchain Inventory - Domain Model Class Diagram

' Professional Color Palette with High Contrast
!define AGGREGATE_COLOR #BF360C
!define AGGREGATE_ACCENT #FFB300
!define ENTITY_COLOR #E65100
!define VALUE_OBJECT_COLOR #F57C00
!define SERVICE_COLOR #2E7D32
!define EVENT_COLOR #1565C0
!define REPO_COLOR #6A1B9A

skinparam backgroundColor #FAFAFA
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontSize 10
skinparam defaultFontName Arial
skinparam classAttributeFontColor #212121
skinparam classFontStyle bold

title <size:20><color:#BF360C><b>Domain Model Class Diagram</b></color></size>\n<size:13><color:#424242>Blockchain Inventory Management System</color></size>

' ============================================
' Aggregate Roots
' ============================================

package "<color:white><b>Aggregates (Aggregate Roots)</b></color>" as Aggregates AGGREGATE_COLOR {

    class InventoryItem <<Aggregate Root>> AGGREGATE_ACCENT {
        - SKU $sku
        - string $name
        - string $description
        - StockLevel[] $stockLevels
        - StockReservation[] $reservations
        - DateTime $createdAt
        - DateTime $updatedAt
        - DomainEvent[] $recordedEvents
        --
        + reserve(Quantity, Warehouse, contractId, expiresAt): StockReservation
        + releaseReservation(reservationId): void
        + commitReservation(reservationId, orderId): void
        + receiveStock(Quantity, Warehouse, supplierRef): void
        + getTotalAvailable(): int
        + getTotalReserved(): int
        + addWarehouse(Warehouse, initialStock): void
        + getRecordedEvents(): DomainEvent[]
        + clearRecordedEvents(): void
    }

    class Warehouse <<Aggregate Root>> AGGREGATE_ACCENT {
        - string $id
        - string $name
        - Address $address
        - int $capacity
        - float $currentLoad
        - bool $operational
        - string[] $regions
        - DateTime $createdAt
        - DateTime $updatedAt
        --
        + canAccept(Quantity): bool
        + markOperational(): void
        + markOffline(): void
        + setCurrentLoad(float): void
        + servesRegion(region): bool
        + calculateShippingCost(Address): float
        + isOperational(): bool
        + getCurrentLoad(): float
    }
}

' ============================================
' Entities
' ============================================

package "<color:white><b>Entities</b></color>" as Entities ENTITY_COLOR {

    class StockReservation <<Entity>> #FFE0B2 {
        {static} STATE_ACTIVE = 'active'
        {static} STATE_COMMITTED = 'committed'
        {static} STATE_RELEASED = 'released'
        {static} STATE_EXPIRED = 'expired'
        --
        - string $id
        - SKU $sku
        - Quantity $quantity
        - Warehouse $warehouse
        - string $contractId
        - string? $orderId
        - string $state
        - DateTime $createdAt
        - DateTime $expiresAt
        - DateTime? $committedAt
        - DateTime? $releasedAt
        --
        + commit(orderId): void
        + release(): void
        + expire(): void
        + isExpired(): bool
        + isActive(): bool
    }

    class StockLevel <<Entity>> #FFE0B2 {
        - Warehouse $warehouse
        - Quantity $available
        - Quantity $reserved
        - Quantity $committed
        --
        + canReserve(Quantity): bool
        + reserve(Quantity): void
        + release(Quantity): void
        + commit(Quantity): void
        + receive(Quantity): void
        + ship(Quantity): void
        + getTotal(): int
        + getAvailable(): int
        + getReserved(): int
        + getCommitted(): int
    }
}

' ============================================
' Value Objects
' ============================================

package "<color:white><b>Value Objects</b> <size:9>(Immutable)</size></color>" as ValueObjects VALUE_OBJECT_COLOR {

    class SKU <<Value Object>> #FFF3E0 {
        - string $value
        --
        + value(): string
        + equals(SKU): bool
        + __toString(): string
        - validate(string): void
    }

    class Quantity <<Value Object>> #FFF3E0 {
        - int $value
        --
        + value(): int
        + add(Quantity): Quantity
        + subtract(Quantity): Quantity
        + equals(Quantity): bool
        + greaterThan(Quantity): bool
        + lessThan(Quantity): bool
    }

    class Address <<Value Object>> #FFF3E0 {
        - string $street
        - string $city
        - string $state
        - string $zip
        - string $country
        - float? $latitude
        - float? $longitude
        --
        + distanceTo(Address): float
        + hasCoordinates(): bool
        + toString(): string
    }
}

' ============================================
' Domain Services
' ============================================

package "<color:white><b>Domain Services</b></color>" as Services SERVICE_COLOR {

    interface InventoryServiceInterface <<Service>> #C8E6C9 {
        + reserveStock(PaymentContract): StockReservation[]
        + releaseStock(PaymentContract): void
        + commitStock(PaymentContract, orderId): void
        + getAvailableStock(sku): int
        + canFulfillContract(PaymentContract): bool
    }

    interface WarehouseAllocatorInterface <<Service>> #C8E6C9 {
        + findOptimal(SKU, Quantity, Address): Warehouse?
        + calculateScore(Warehouse, Address): float
        + shouldSplitShipment(items[]): bool
    }
}

' ============================================
' Domain Events
' ============================================

package "<color:white><b>Domain Events</b></color>" as Events EVENT_COLOR {

    abstract class DomainEvent <<Event>> #BBDEFB {
        - string $eventId
        - DateTime $occurredAt
        - array $metadata
        --
        {abstract} + getEventName(): string
        {abstract} + getPayload(): array
    }

    class StockReservedEvent <<Event>> #E3F2FD {
        - SKU $sku
        - Quantity $quantity
        - string $warehouseId
        - string $contractId
        - string $reservationId
        --
        + getEventName(): string
        + getPayload(): array
    }

    class StockReleasedEvent <<Event>> #E3F2FD {
        - SKU $sku
        - Quantity $quantity
        - string $warehouseId
        - string $contractId
        - string $reservationId
        --
        + getEventName(): string
        + getPayload(): array
    }

    class StockCommittedEvent <<Event>> #E3F2FD {
        - SKU $sku
        - Quantity $quantity
        - string $warehouseId
        - string $contractId
        - string $orderId
        - string $reservationId
        --
        + getEventName(): string
        + getPayload(): array
    }
}

' ============================================
' Repositories
' ============================================

package "<color:white><b>Repositories</b> <size:9>(Infrastructure)</size></color>" as Repositories REPO_COLOR {

    interface InventoryItemRepositoryInterface <<Repository>> #E1BEE7 {
        + findBySku(SKU): InventoryItem?
        + save(InventoryItem): void
        + findLowStock(threshold): InventoryItem[]
        + findByWarehouse(warehouseId): InventoryItem[]
    }

    interface WarehouseRepositoryInterface <<Repository>> #E1BEE7 {
        + findById(id): Warehouse?
        + findAll(): Warehouse[]
        + findOperational(): Warehouse[]
        + save(Warehouse): void
    }

    interface StockReservationRepositoryInterface <<Repository>> #E1BEE7 {
        + findById(id): StockReservation?
        + findByContract(contractId): StockReservation[]
        + findExpired(): StockReservation[]
        + save(StockReservation): void
    }
}

' ============================================
' Relationships
' ============================================

' Aggregate composition
InventoryItem "1" *-- "0..*" StockLevel : contains
InventoryItem "1" *-- "0..*" StockReservation : tracks
InventoryItem "1" o-- "1" SKU : identified by
InventoryItem "1" *-- "0..*" DomainEvent : emits

' StockLevel composition
StockLevel "1" o-- "1" Warehouse : located at
StockLevel "1" o-- "3" Quantity : available, reserved, committed

' StockReservation composition
StockReservation "1" o-- "1" SKU : for product
StockReservation "1" o-- "1" Quantity : amount
StockReservation "1" o-- "1" Warehouse : from

' Warehouse composition
Warehouse "1" o-- "1" Address : located at

' Domain events inheritance
StockReservedEvent --|> DomainEvent
StockReleasedEvent --|> DomainEvent
StockCommittedEvent --|> DomainEvent

' Services use aggregates
InventoryServiceInterface ..> InventoryItem : uses
InventoryServiceInterface ..> Warehouse : uses
WarehouseAllocatorInterface ..> Warehouse : uses
WarehouseAllocatorInterface ..> Address : uses

' Repositories manage aggregates
InventoryItemRepositoryInterface ..> InventoryItem : persists
WarehouseRepositoryInterface ..> Warehouse : persists
StockReservationRepositoryInterface ..> StockReservation : persists

' Events emitted by aggregates
InventoryItem ..> StockReservedEvent : emits
InventoryItem ..> StockReleasedEvent : emits
InventoryItem ..> StockCommittedEvent : emits

' ============================================
' Notes
' ============================================

note top of InventoryItem #FFECB3
  <b><color:#BF360C>Aggregate Root</color></b>
  ━━━━━━━━━━━━━━━━━━━━
  ✓ Enforces invariants
  ✓ Emits domain events
  ✓ Transaction boundary
  ✓ Consistency guarantee
end note

note top of StockReservation #FFE0B2
  <b><color:#E65100>Entity</color></b>
  ━━━━━━━━━━━━━━━━
  ✓ Has identity
  ✓ State transitions
  ✓ Lifecycle management
  ✓ Linked to contract
end note

note top of SKU #FFF8E1
  <b><color:#F57C00>Value Object</color></b>
  ━━━━━━━━━━━━━━━━━━
  ✓ Immutable
  ✓ No identity
  ✓ Replaceable
  ✓ Validated on creation
end note

note right of InventoryServiceInterface #E8F5E9
  <b><color:#2E7D32>Domain Service</color></b>
  ━━━━━━━━━━━━━━━━━━━━
  Orchestrates operations
  across multiple aggregates
  (InventoryItem + Warehouse)
end note

note bottom of DomainEvent #E3F2FD
  <b><color:#1565C0>Event Sourcing</color></b>
  ━━━━━━━━━━━━━━━━━━━━
  All state changes captured
  as immutable events.
  Appended to ledger.
end note

note left of InventoryItemRepositoryInterface #F3E5F5
  <b><color:#6A1B9A>Repository Pattern</color></b>
  ━━━━━━━━━━━━━━━━━━━━━━━━
  Abstracts data access.
  Infrastructure layer
  implements persistence.
end note

' Professional Legend with Color Meanings
legend right
  <size:14><b>Domain-Driven Design Patterns</b></size>
  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  |<back:#FFB300>     </back>| <b>Aggregate Root</b> | Transaction boundary, enforces invariants |
  |<back:#FFE0B2>     </back>| <b>Entity</b> | Has identity, lifecycle management |
  |<back:#FFF3E0>     </back>| <b>Value Object</b> | Immutable, no identity, replaceable |
  |<back:#C8E6C9>     </back>| <b>Domain Service</b> | Multi-aggregate orchestration |
  |<back:#BBDEFB>     </back>| <b>Domain Event</b> | State change notification |
  |<back:#E1BEE7>     </back>| <b>Repository</b> | Data access abstraction |

  <size:11><b>Design Principles:</b></size>
  • Rich domain models with business logic
  • Encapsulation & information hiding
  • Ubiquitous language in code
  • Event-driven architecture
endlegend

@enduml
