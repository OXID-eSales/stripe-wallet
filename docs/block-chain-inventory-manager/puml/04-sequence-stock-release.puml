@startuml Stock Release Sequence

!define PAYMENT_COLOR #E3F2FD
!define HANDLER_COLOR #FFF3E0
!define EVENT_COLOR #E8F5E9
!define ERROR_COLOR #FFEBEE

title Stock Release Flow - Payment Failure or Contract Expiration

' Participants
participant "Payment\nComponent" as Payment #1976D2
participant "ReleaseStock\nHandler" as Handler #FF9800
participant "Inventory\nService" as Service #9C27B0
participant "Inventory\nItem" as Item #FF6F00
participant "Stock\nReservation" as Reservation #FFA726
participant "Inventory\nLedger" as Ledger #7B1FA2
participant "Event\nStore" as EventStore #4A148C
participant "Redis\nCache" as Cache #D32F2F
participant "Contract\nRepository" as ContractRepo #0288D1

' ============================================
' Scenario 1: Payment Failed
' ============================================

== Scenario 1: Payment Failed ==

Payment -> Handler : **PaymentFailedEvent**\ncontractId: "ctr_123"\nreason: "Card declined"
activate Handler #FFE0B2

note right of Payment ERROR_COLOR
  **Trigger: Payment Failed**
  - Card declined
  - Fraud detected
  - Technical error
  → Stock must be released
end note

Handler -> ContractRepo : getContract("ctr_123")
activate ContractRepo #B3E5FC
ContractRepo --> Handler : PaymentContract
deactivate ContractRepo

Handler -> Service : **releaseStock(contract)**
activate Service #E1BEE7

Service -> Service : Get reservation IDs\nfrom contract

loop For each reservation

    Service -> Item : **releaseReservation**(reservationId)
    activate Item #FFE082

    Item -> Reservation : findReservation(reservationId)
    activate Reservation #FFCC80
    Reservation --> Item : StockReservation
    deactivate Reservation

    alt Reservation Found and Active

        Item -> Item : Update StockLevel:\nreserved → available
        note right of Item #FFF9C4
          **Stock Movement**
          Before: available=99, reserved=1
          After:  available=100, reserved=0
        end note

        Item -> Reservation : **release()**
        activate Reservation #FFCC80
        Reservation -> Reservation : state = RELEASED\nreleasedAt = now()
        Reservation --> Item : OK
        deactivate Reservation

        Item -> Item : **Emit: StockReleasedEvent**

        Item -> Ledger : **append(StockReleasedEvent)**
        activate Ledger #BA68C8

        note right of Ledger EVENT_COLOR
          **Audit Trail**
          Event: STOCK_RELEASED
          Links to: STOCK_RESERVED
          → Complete history
        end note

        Ledger -> EventStore : Persist event
        activate EventStore #7B1FA2
        EventStore --> Ledger : OK
        deactivate EventStore

        Ledger --> Item : OK
        deactivate Ledger

        Item -> Cache : **INCRBY** stock:available:{SKU} {qty}
        activate Cache #FFCDD2
        Cache --> Item : New value: 100
        deactivate Cache

        Item --> Service : ✅ Released
        deactivate Item

    else Reservation Not Found / Already Released

        Item --> Service : ⚠️ Already released (idempotent)
        note right of Item #FFF9C4
          **Idempotency**
          Duplicate PaymentFailedEvent
          → No-op, return success
        end note

    end

end

Service --> Handler : OK
deactivate Service

Handler -> ContractRepo : **contract.failCondition**(\n'STOCK_RESERVED')
activate ContractRepo #B3E5FC
ContractRepo --> Handler : OK
deactivate ContractRepo

Handler --> Payment : ✅ Stock released
deactivate Handler

' ============================================
' Scenario 2: Contract Expiration
' ============================================

== Scenario 2: Contract Expiration (Timeout) ==

participant "Contract\nExpiry\nScheduler" as Scheduler #F57C00

Scheduler -> Scheduler : **Cron job runs**\nEvery 1 minute
activate Scheduler #FFE0B2

note right of Scheduler #FFF3E0
  **Scheduled Task**
  Find contracts:
  - state = PENDING
  - expiresAt < now()
  → Auto-release stock
end note

Scheduler -> ContractRepo : **findExpired()**
activate ContractRepo #B3E5FC
ContractRepo --> Scheduler : Contract[]
deactivate ContractRepo

loop For each expired contract

    Scheduler -> Handler : **ContractExpiredEvent**\ncontractId: "ctr_456"
    activate Handler #FFE0B2

    Handler -> ContractRepo : getContract("ctr_456")
    activate ContractRepo #B3E5FC
    ContractRepo --> Handler : PaymentContract
    deactivate ContractRepo

    Handler -> Service : **releaseStock(contract)**
    activate Service #E1BEE7

    note right of Service ERROR_COLOR
      **Timeout Scenario**
      Contract created 5 mins ago
      Payment never captured
      → Release reserved stock
    end note

    Service -> Item : releaseReservation(reservationId)
    activate Item #FFE082

    Item -> Reservation : **expire()**
    activate Reservation #FFCC80
    Reservation -> Reservation : state = EXPIRED
    Reservation --> Item : OK
    deactivate Reservation

    Item -> Item : Update StockLevel\nEmit StockReleasedEvent
    Item -> Ledger : append(event)
    activate Ledger #BA68C8
    Ledger --> Item : OK
    deactivate Ledger

    Item -> Cache : INCRBY stock:available
    activate Cache #FFCDD2
    Cache --> Item : OK
    deactivate Cache

    Item --> Service : OK
    deactivate Item

    Service --> Handler : OK
    deactivate Service

    Handler -> ContractRepo : contract.expire()
    activate ContractRepo #B3E5FC
    ContractRepo --> Handler : OK
    deactivate ContractRepo

    Handler --> Scheduler : ✅ Expired and released
    deactivate Handler

end

Scheduler --> Scheduler : Done
deactivate Scheduler

' ============================================
' Result Summary
' ============================================

== Result ==

note over Payment, Cache EVENT_COLOR
  **Outcome (Both Scenarios)**
  1. Stock returned to available pool
  2. Reservation marked as RELEASED/EXPIRED
  3. Event appended to immutable ledger
  4. Cache updated immediately
  5. Contract condition failed/expired
  6. Complete audit trail maintained

  **Guarantees**
  - Idempotent (safe to retry)
  - Atomic (all-or-nothing)
  - Auditable (event log)
end note

@enduml
