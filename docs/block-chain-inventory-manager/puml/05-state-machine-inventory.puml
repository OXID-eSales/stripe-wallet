@startuml Inventory State Machine

!define INITIAL_COLOR #E8F5E9
!define ACTIVE_COLOR #FFF9C4
!define SUCCESS_COLOR #C8E6C9
!define ERROR_COLOR #FFCDD2
!define TERMINAL_COLOR #B0BEC5

title Stock Reservation & Inventory Item State Machine

' ============================================
' Stock Reservation State Machine
' ============================================

state "Stock Reservation Lifecycle" as ReservationSM {

    [*] --> ACTIVE : reserve()

    state ACTIVE #FFF9C4 {
        state "Reservation\nACTIVE" as Active
        Active : ✅ Stock held for contract
        Active : ⏱️ Expires in 5 minutes
        Active : 📦 Warehouse allocated
    }

    state COMMITTED SUCCESS_COLOR {
        state "Reservation\nCOMMITTED" as Committed
        Committed : ✅ Order created
        Committed : 🔒 Stock permanently allocated
        Committed : 📦 Ready to ship
    }

    state RELEASED ERROR_COLOR {
        state "Reservation\nRELEASED" as Released
        Released : ❌ Payment failed
        Released : ↩️ Stock returned to pool
        Released : 📝 Audit trail updated
    }

    state EXPIRED ERROR_COLOR {
        state "Reservation\nEXPIRED" as Expired
        Expired : ⏰ Timeout (5 min)
        Expired : ↩️ Stock returned to pool
        Expired : 🗑️ Cleaned by scheduler
    }

    ACTIVE --> COMMITTED : commit(orderId)\n[Payment captured]
    ACTIVE --> RELEASED : release()\n[Payment failed]
    ACTIVE --> EXPIRED : expire()\n[Timeout]

    COMMITTED --> [*]
    RELEASED --> [*]
    EXPIRED --> [*]
}

note right of ACTIVE
  **Business Rules**
  - Stock reserved for contract
  - Linked to payment authorization
  - Automatic expiry after timeout
  - Can be released on payment failure
end note

note right of COMMITTED
  **Terminal State**
  Order created, stock allocated.
  Next step: Ship from warehouse.
end note

note right of RELEASED
  **Terminal State**
  Payment failed, stock returned.
  Available for other customers.
end note

note right of EXPIRED
  **Terminal State**
  Contract timeout, auto-cleanup.
  Stock returned to available pool.
end note

' ============================================
' Inventory Item State Machine
' ============================================

state "Inventory Item Stock Levels" as InventorySM {

    state "Stock Level Transitions" as StockTransitions {

        state AVAILABLE INITIAL_COLOR {
            state "AVAILABLE" as Available
            Available : 📦 Can be reserved
            Available : 🔓 Not locked
            Available : 📊 Visible to customers
        }

        state RESERVED ACTIVE_COLOR {
            state "RESERVED" as Reserved
            Reserved : 🔒 Held for contract
            Reserved : ⏱️ Temporary (5 min)
            Reserved : 🚫 Not available for others
        }

        state COMMITTED SUCCESS_COLOR {
            state "COMMITTED" as CommittedStock
            CommittedStock : ✅ Allocated to order
            CommittedStock : 🔒 Permanent allocation
            CommittedStock : 📦 Awaiting shipment
        }

        state SHIPPED TERMINAL_COLOR {
            state "SHIPPED" as Shipped
            Shipped : 📬 Left warehouse
            Shipped : ✅ Order fulfilled
            Shipped : 🚚 In transit
        }

        [*] --> AVAILABLE : receiveStock()\n[Supplier delivery]

        AVAILABLE --> RESERVED : reserve()\n[Payment authorized]

        RESERVED --> AVAILABLE : release()\n[Payment failed or expired]
        RESERVED --> COMMITTED : commit()\n[Order created]

        COMMITTED --> SHIPPED : ship()\n[Warehouse ships]

        SHIPPED --> [*]
    }
}

note right of Available
  **Available Stock**
  Ready to be reserved.
  Shown to customers.
  Query: SELECT available FROM stock_level
end note

note right of Reserved
  **Reserved Stock**
  Temporary hold (5 min).
  Linked to payment contract.
  Auto-release on timeout.
end note

note right of CommittedStock
  **Committed Stock**
  Permanent allocation.
  Order created, awaiting shipment.
  Inventory reduced from total.
end note

note right of Shipped
  **Shipped Stock**
  Physically left warehouse.
  Order fulfilled.
  Removed from inventory.
end note

' ============================================
' State Transition Events
' ============================================

state "Domain Events Emitted" as Events {

    state "Event Types" as EventTypes {
        state "📌 StockReservedEvent" as E1 #FFE082
        state "↩️ StockReleasedEvent" as E2 #FFCDD2
        state "✅ StockCommittedEvent" as E3 #C8E6C9
        state "📦 StockShippedEvent" as E4 #B0BEC5
        state "📥 StockReceivedEvent" as E5 #E8F5E9
    }

    E1 : Emitted when: reserve()
    E1 : Ledger: Appended with hash chain
    E1 : Cache: DECRBY available

    E2 : Emitted when: release() or expire()
    E2 : Ledger: Links to original reservation
    E2 : Cache: INCRBY available

    E3 : Emitted when: commit()
    E3 : Ledger: Links to order creation
    E3 : Cache: No change (already in reserved)

    E4 : Emitted when: ship()
    E4 : Ledger: Complete fulfillment
    E4 : Cache: DECRBY committed

    E5 : Emitted when: receiveStock()
    E5 : Ledger: Supplier delivery
    E5 : Cache: INCRBY available
}

' ============================================
' Legend
' ============================================

legend right
    |= Color |= Meaning |
    |<INITIAL_COLOR>      | Initial/Available |
    |<ACTIVE_COLOR>       | Active/Processing |
    |<SUCCESS_COLOR>      | Success/Committed |
    |<ERROR_COLOR>        | Error/Released |
    |<TERMINAL_COLOR>     | Terminal State |
endlegend

@enduml
