@startuml delayed-capture-flow

title Delayed/Manual Capture Flow with Smart-Contract Architecture

skinparam backgroundColor #FEFEFE
skinparam sequenceArrowThickness 2
skinparam roundcorner 10
skinparam maxmessagesize 200

actor Customer
participant "Shop Frontend" as Frontend
participant "StripeOrderController" as Controller
participant "CheckoutSessionService" as CheckoutSvc
participant "Stripe API" as StripeAPI
participant "StripeCheckoutReturnHandler" as ReturnHandler
participant "PaymentContract" as Contract
participant "ContractRepository" as ContractRepo
database "Database" as DB

== Phase 1: Checkout with Manual Capture ==

Customer -> Frontend: Click "Place Order"
Frontend -> Controller: initiate checkout

Controller -> CheckoutSvc: createCheckoutSession()
note right
  CaptureConfigurationService
  returns 'manual' mode
end note

CheckoutSvc -> StripeAPI: checkout.sessions.create(\n  payment_intent_data: {\n    **capture_method: 'manual'**\n  }\n)
StripeAPI --> CheckoutSvc: Checkout Session

CheckoutSvc -> Contract: Create contract (DRAFT)
Contract -> ContractRepo: save()
ContractRepo -> DB: INSERT osc_payment_contract

Customer -> StripeAPI: Complete payment on Stripe Checkout
StripeAPI --> Customer: Redirect to success URL

== Phase 2: Return Flow - Authorization Only ==

Customer -> Controller: checkoutSuccess()
Controller -> ReturnHandler: handle(StripeCheckoutReturnEvent)

ReturnHandler -> StripeAPI: paymentIntents.retrieve(pi_xxx)
StripeAPI --> ReturnHandler: PaymentIntent {\n  status: **'requires_capture'**\n}

note right of ReturnHandler #LightYellow
  Key difference from automatic mode:
  Status is 'requires_capture'
  NOT 'succeeded'
end note

ReturnHandler -> Contract: authorize()
Contract -> Contract: state: PENDING -> **AUTHORIZED**
ReturnHandler -> ContractRepo: save(contract)
ContractRepo -> DB: UPDATE state='authorized'

ReturnHandler --> Controller: ContractAuthorizedEvent dispatched

Controller --> Frontend: Show "Order authorized" page
Frontend --> Customer: "Your order is confirmed.\nPayment will be charged when items ship."

== Phase 3: Admin Manual Capture ==

actor Admin
participant "Admin Backend" as AdminUI
participant "OrderCapture Controller" as CaptureCtrl
participant "EventDispatcher" as Dispatcher
participant "StripeCaptureHandler" as CaptureHandler

Admin -> AdminUI: View Order Details
AdminUI -> CaptureCtrl: render()
CaptureCtrl --> AdminUI: Show "Capture Payment" button

Admin -> AdminUI: Click "Capture Full Amount"
AdminUI -> CaptureCtrl: captureFullAmount()

CaptureCtrl -> Dispatcher: dispatch(CaptureRequestedEvent)
Dispatcher -> CaptureHandler: handle(event)

CaptureHandler -> ContractRepo: findById(contractId)
ContractRepo --> CaptureHandler: Contract (state=AUTHORIZED)

CaptureHandler -> StripeAPI: paymentIntents.capture(pi_xxx)
StripeAPI --> CaptureHandler: PaymentIntent {\n  status: 'succeeded',\n  charges: [{ captured: true }]\n}

CaptureHandler -> Contract: captureAuthorization()
Contract -> Contract: state: AUTHORIZED -> **READY_TO_COMMIT**
CaptureHandler -> ContractRepo: save(contract)

CaptureHandler -> Dispatcher: dispatch(PaymentCapturedEvent)

note right of Dispatcher #LightGreen
  Existing handlers process:
  - Update OXPAID
  - Create Order (if not created)
  - Transition to COMMITTED
  - Fulfill contract
end note

CaptureHandler --> CaptureCtrl: Success
CaptureCtrl --> AdminUI: "Payment captured successfully"
AdminUI --> Admin: Order status: Completed

== Alternative: Webhook Confirmation ==

participant "Webhook Controller" as WebhookCtrl
participant "ChargeCapturedHandler" as ChargeHandler

StripeAPI -> WebhookCtrl: POST /webhook\ncharge.captured
WebhookCtrl -> ChargeHandler: handle(StripeEvent)

ChargeHandler -> ContractRepo: findByMetadata(\n  'provider_payment_id', pi_xxx\n)
ContractRepo --> ChargeHandler: Contract

ChargeHandler -> Contract: captureAuthorization()\n(if still AUTHORIZED)
ChargeHandler -> ContractRepo: save(contract)
ChargeHandler -> Dispatcher: dispatch(PaymentCapturedEvent)

note right of ChargeHandler #LightBlue
  Idempotent: Skips if
  already captured
end note

@enduml
