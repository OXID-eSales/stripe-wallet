title Event-Driven Architecture - Event System

package "Component\EventSystem" {
    interface EventDispatcherInterface {
        +addListener(eventClass: string, listener: callable, priority: int): void
        +removeListener(eventClass: string, listener: callable): void
        +dispatch(event: EventInterface): EventInterface
    }

    class EventDispatcher {
        -listeners: array<string, array<array>>
        ..
        +addListener(eventClass, listener, priority = 0): void
        +removeListener(eventClass, listener): void
        +dispatch(event): EventInterface
        ..
        -getSortedListeners(eventClass): array
        -isStoppableEvent(event): bool
    }

    EventDispatcher ..|> EventDispatcherInterface

    note right of EventDispatcher
        **Observer Pattern with Priorities**

        Listener Storage:
        [
          EventClass => [
            ['listener' => callable, 'priority' => int],
            ...
          ]
        ]

        Execution:
        - Listeners sorted by priority (DESC)
        - Supports stoppable events (PSR-14)
        - Returns modified event object
    end note
}

package "Component\EventSystem\Event" {
    interface EventInterface {
        +getContext(): EventContextInterface
    }

    interface EventContextInterface {
        +getEventId(): string
        +getTimestamp(): DateTimeInterface
        +getMetadata(): array
        +addMetadata(key: string, value: mixed): self
    }

    class EventContext {
        -eventId: string
        -timestamp: DateTimeImmutable
        -metadata: array
        ..
        +__construct(?eventId, ?timestamp, metadata)
        +getEventId(): string
        +getTimestamp(): DateTimeInterface
        +getMetadata(): array
        +addMetadata(key, value): self
    }

    EventContext ..|> EventContextInterface
}

