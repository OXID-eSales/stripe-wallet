@startuml OxidWatch Testing Port API Architecture

skinparam linetype ortho
skinparam backgroundColor #FEFEFE
skinparam roundcorner 8
skinparam shadowing false

title OxidWatch Testing Port API\nE2E Testing & Real-time Monitoring Architecture

!define SHOP_SIDE #E3F2FD
!define API_LAYER #FFF9C4
!define SECURITY #FFCCBC
!define TESTING #C8E6C9
!define MONITORING #F8BBD0
!define DATABASE #E1BEE7

' =====================================
' Customer & Shop Frontend
' =====================================
actor "Customer" as Customer
package "OXID eShop Frontend" as SHOP_PKG SHOP_SIDE {
    component [Product Page] as ProductPage
    component [Shopping Cart] as Cart
    component [Checkout] as Checkout
    component [Payment Gateway\n(Stripe/PayPal)] as PaymentGateway
    component [Order Confirmation] as OrderConfirmation

    database "OXID Database\nMySQL" as ShopDB DATABASE

    note right of ShopDB
        **Order Tables:**
        • oxorder (orders)
        • oxorder__oxpayments (transactions)
        • oxuser (customers)

        **Key Fields:**
        • OXORDERNR (order number)
        • OXTRANSID (transaction ID)
        • OXUSERID (customer ID)
    end note
}

' =====================================
' Testing Port API Layer
' =====================================
package "OxidWatch Testing Port API" as API_PKG API_LAYER {
    component [HTTP Endpoint\nPOST /api/v1/testing-port/\nrecent-orders] as Endpoint

    package "Security Layer" as SECURITY_PKG SECURITY {
        component [IP Whitelist\nValidator] as IPValidator
        component [API Key\nValidator] as APIKeyValidator
        component [Timestamp\nValidator] as TimestampValidator
        component [HMAC Signature\nVerifier] as SignatureVerifier
        component [Nonce/Replay\nProtection] as NonceValidator
        component [Rate Limiter\n100 req/min] as RateLimiter
    }

    component [Order Query\nService] as OrderQueryService
    component [Active User\nQuery Service] as UserQueryService
    component [Response Builder\nJSON] as ResponseBuilder

    database "Redis Cache" as Redis DATABASE

    note right of SECURITY_PKG
        **Authentication Flow:**
        1. Check IP whitelist
        2. Validate API key
        3. Check timestamp (±5 min)
        4. Verify HMAC signature
        5. Check nonce (no replay)
        6. Check rate limit
    end note
}

' =====================================
' E2E Testing Framework
' =====================================
package "E2E Testing Framework" as TEST_PKG TESTING {
    component [Playwright/Cypress\nTest Runner] as TestRunner
    component [Testing Port\nClient Library] as TestClient
    component [Test Assertions] as TestAssertions

    note right of TEST_PKG
        **Test Flow:**
        1. Execute checkout in browser
        2. Place test order
        3. Get order # from confirmation
        4. Call Testing Port API
        5. Verify order in response
        6. Assert transaction details

        **Example:**
        • Order placed: ORD-2025-001
        • Call API with signature
        • Find order in last 10
        • Verify: status, amount, payment ID
    end note
}

' =====================================
' Real-time Monitoring System
' =====================================
package "Real-time Monitoring" as MONITOR_PKG MONITORING {
    component [Order Monitor\nScript (Python)] as MonitorScript
    component [Dashboard\nWeb UI] as Dashboard
    component [Alert System] as AlertSystem

    note right of MONITOR_PKG
        **Monitoring Tasks:**
        • Poll API every 60s
        • Check for new orders
        • Display order feed
        • Alert if no orders > 30 min
        • Track processing latency
    end note
}

' =====================================
' Request/Response Flow Diagrams
' =====================================
rectangle "API Request Structure" as REQUEST SECURITY {
    note as ReqNote
        **HTTP Headers:**
        X-API-Key: tp_live_sk_abc123
        X-Request-Timestamp: 1697472000
        X-Request-Signature: sha256_hmac...

        **Request Body (JSON):**
        {
          "timestamp": 1697472000,
          "nonce": "32-char-hex-string",
          "options": {
            "limit": 10,
            "include_user_data": true,
            "include_transaction_data": true,
            "time_window_seconds": 3600
          }
        }

        **Signature Calculation:**
        HMAC-SHA256(request_body, secret_key)
    end note
}

rectangle "API Response Structure" as RESPONSE TESTING {
    note as RespNote
        **Success Response (200 OK):**
        {
          "success": true,
          "timestamp": 1697472100,
          "data": {
            "recent_orders": [
              {
                "order_id": "12345",
                "order_number": "ORD-2025-10-16-001",
                "transaction_id": "TXN-ABC-123",
                "payment_transaction_id": "pi_123abc",
                "order_date": "2025-10-16T14:32:15Z",
                "total_amount": 99.99,
                "currency": "EUR",
                "status": "completed",
                "payment_method": "stripe_card",
                "customer_id": "user_xyz",
                "created_at": 1697472735
              }
            ],
            "active_users": [...],
            "statistics": {
              "total_orders_returned": 10,
              "time_window_seconds": 3600,
              "oldest_order_age_seconds": 3540,
              "newest_order_age_seconds": 15
            }
          },
          "meta": {
            "api_version": "1.0.0",
            "shop_version": "7.0.0",
            "oxidwatch_version": "1.2.3",
            "request_id": "req_1697472100_abc123"
          }
        }
    end note
}

' =====================================
' Customer Flow
' =====================================
Customer --> ProductPage : 1. Browse products
ProductPage --> Cart : 2. Add to cart
Cart --> Checkout : 3. Proceed to checkout
Checkout --> PaymentGateway : 4. Enter payment details
PaymentGateway --> ShopDB : 5. Create order
ShopDB --> OrderConfirmation : 6. Show confirmation
OrderConfirmation --> Customer : 7. Order # displayed

' =====================================
' Testing Port API Flow
' =====================================
ShopDB --> OrderQueryService : Query recent orders

TestRunner --> TestClient : Execute test
TestClient --> Endpoint : POST with signed request
MonitorScript --> Endpoint : Poll every 60s

Endpoint --> IPValidator : Validate IP
IPValidator --> APIKeyValidator : Check API key
APIKeyValidator --> TimestampValidator : Check timestamp
TimestampValidator --> SignatureVerifier : Verify signature
SignatureVerifier --> NonceValidator : Check nonce
NonceValidator --> RateLimiter : Check rate limit

RateLimiter --> OrderQueryService : If valid
OrderQueryService --> ShopDB : SELECT last 10 orders
OrderQueryService --> Redis : Check cache
UserQueryService --> ShopDB : SELECT active users

OrderQueryService --> ResponseBuilder : Build response
UserQueryService --> ResponseBuilder : Add users
ResponseBuilder --> Endpoint : JSON response

Endpoint --> TestClient : Return data
TestClient --> TestAssertions : Validate

Endpoint --> MonitorScript : Return data
MonitorScript --> Dashboard : Display orders
MonitorScript --> AlertSystem : Alert if issues

' =====================================
' Security Flow Detail
' =====================================
package "Security Validation Detail" as SECURITY_DETAIL SECURITY {
    rectangle "Request Validation\n\n1. IP Whitelist\n2. API Key\n3. Timestamp ±5min\n4. HMAC Signature\n5. Nonce Uniqueness\n6. Rate Limit" as ReqValidation

    note right of ReqValidation
        **All checks must pass**
        Fail → 401/403 error
        Pass → Query database

        **Rate Limits:**
        • 100 req/min per IP
        • 1000 req/hour per API key
        • Auto-ban after 10 fails
    end note
}

' =====================================
' Database Query Optimization
' =====================================
rectangle "Optimized Queries" as QUERIES DATABASE {
    note as QueryNote
        **Query 1: Recent Orders**
        SELECT o.OXORDERNR, o.OXTRANSID, ...
        FROM oxorder o
        WHERE o.OXORDERDATE >= NOW() - INTERVAL 1 HOUR
        ORDER BY o.OXORDERDATE DESC
        LIMIT 10

        **Index:** idx_oxorder_orderdate

        **Query 2: Active Users**
        SELECT DISTINCT u.OXID, u.OXUSERNAME
        FROM oxuser u
        INNER JOIN oxorder o ON u.OXID = o.OXUSERID
        WHERE o.OXORDERDATE >= NOW() - INTERVAL 1 HOUR
        LIMIT 50

        **Index:** idx_oxorder_userid_date

        **Performance:**
        • Average query time: <10ms
        • Cache TTL: 30 seconds
        • Zero impact on shop performance
    end note
}

ShopDB -- QueryNote

' =====================================
' Use Case Scenarios
' =====================================
rectangle "Use Case 1: E2E Testing" as UC1 TESTING {
    note as UC1Note
        **Scenario:** CI/CD Pipeline Test

        1. Test runner starts
        2. Execute checkout flow
        3. Place order with test data
        4. Extract order number
        5. Call Testing Port API
        6. Verify order exists
        7. Assert: status, amount, payment
        8. Test passes ✅

        **Result:**
        • Full checkout validated
        • Payment integration confirmed
        • Order creation verified
        • Time: ~30 seconds
    end note
}

rectangle "Use Case 2: Production Monitoring" as UC2 MONITORING {
    note as UC2Note
        **Scenario:** Real-time Shop Monitoring

        1. Monitor polls API every 60s
        2. Retrieves last 10 orders
        3. Displays in dashboard
        4. Checks for new orders
        5. If no orders for 30 min → Alert
        6. Send notification to team

        **Result:**
        • Live order visibility
        • Immediate issue detection
        • Reduced MTTR
        • Happy customers 😊
    end note
}

TestRunner -- UC1Note
MonitorScript -- UC2Note

' =====================================
' Error Handling
' =====================================
rectangle "Error Responses" as ERRORS SECURITY {
    note as ErrorNote
        **401 Unauthorized:**
        • Invalid API key
        • Invalid signature
        • Expired timestamp
        • Replay attack (nonce used)

        **403 Forbidden:**
        • IP not whitelisted

        **429 Too Many Requests:**
        • Rate limit exceeded

        **400 Bad Request:**
        • Invalid JSON
        • Missing required fields

        **500 Internal Server Error:**
        • Database error
        • Unexpected exception

        **Example Error Response:**
        {
          "success": false,
          "error": {
            "code": "INVALID_SIGNATURE",
            "message": "Request signature validation failed",
            "timestamp": 1697472100,
            "request_id": "req_xyz789"
          }
        }
    end note
}

Endpoint -- ErrorNote

' =====================================
' Performance Metrics
' =====================================
rectangle "Performance SLA" as PERF TESTING {
    note as PerfNote
        **Target Metrics:**
        • Response Time: <100ms (P95)
        • Availability: 99.9%
        • Throughput: 1000 req/min
        • Error Rate: <0.1%

        **Actual Results (Load Test):**
        ✅ Avg Response: 45ms
        ✅ P95 Response: 120ms
        ✅ P99 Response: 250ms
        ✅ Error Rate: 0.02%
        ✅ Concurrent Users: 100

        **Optimizations:**
        • Redis caching (30s TTL)
        • Optimized DB indexes
        • Connection pooling
        • Gzip compression
    end note
}

ResponseBuilder -- PerfNote

' =====================================
' Configuration & Setup
' =====================================
rectangle "Configuration" as CONFIG API_LAYER {
    note as ConfigNote
        **Environment Variables:**
        TESTING_PORT_API_KEY=tp_live_sk_abc123
        TESTING_PORT_SECRET_KEY=sk_secret_xyz789
        TESTING_PORT_ALLOWED_IPS=203.0.113.0/24
        REDIS_HOST=localhost
        REDIS_PORT=6379

        **API Key Format:**
        tp_{env}_{type}_{random}
        • env: test | live
        • type: sk (secret key)
        • random: 16-char hex

        **Security Best Practices:**
        ✅ Store keys in .env (never commit)
        ✅ Rotate keys every 90 days
        ✅ Use HTTPS only (TLS 1.3)
        ✅ Monitor for abuse
        ✅ Log all requests
    end note
}

Endpoint -- ConfigNote

