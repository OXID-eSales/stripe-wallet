@startuml E-Commerce Backend Integration Flow

skinparam backgroundColor #1A1A2E
skinparam roundcorner 10
skinparam shadowing true
skinparam packageStyle rectangle
skinparam linetype ortho

' Make all lines and arrows white/visible
skinparam ArrowColor #FFFFFF
skinparam linecolor #FFFFFF

' Make package text dark for bright package backgrounds
skinparam packageFontColor #000000
skinparam packageBorderColor #FFFFFF
skinparam packageBackgroundColor transparent

' Make component text dark for bright backgrounds
skinparam componentFontColor #000000
skinparam componentFontSize 12
skinparam componentFontStyle bold

' Make database/queue/cloud text dark for bright backgrounds
skinparam databaseFontColor #000000
skinparam queueFontColor #000000
skinparam cloudFontColor #000000

' Make note text white with dark background
skinparam noteFontColor #FFFFFF
skinparam noteBorderColor #FFFFFF
skinparam noteBackgroundColor #2C3E50

' Futurama Color Palette
!define FUTURAMA_ORANGE #FF6B35
!define FUTURAMA_BLUE #4ECDC4
!define FUTURAMA_PURPLE #9B59B6
!define FUTURAMA_GREEN #2ECC71
!define FUTURAMA_YELLOW #F4D03F
!define FUTURAMA_RED #E74C3C
!define FUTURAMA_CYAN #16A085
!define FUTURAMA_PINK #E91E63

title <color:#FF6B35><b>E-Commerce Backend Integration</b></color><color:#FFFFFF> | Optional Order Management Layer</color>

' =====================================
' CLIENT LAYER (OPTIONAL)
' =====================================
package "Client Layer (Optional)" as CLIENT <<Rectangle>> FUTURAMA_ORANGE {
  [OXID Storefront] as OXID_UI #FF8C61
  [Standalone Booking UI] as STANDALONE_UI #FF8C61
  [Mobile App] as MOBILE_UI #FF8C61
}

note right of CLIENT : <color:#FFFFFF><b>E-commerce provides optional UI</b></color>

' =====================================
' BOOKING PLATFORM CORE
' =====================================
package "Booking Platform Core (Required)" as CORE <<Rectangle>> FUTURAMA_PURPLE {
  [Booking Service] as BOOKING_SVC #9B59B6
  [Resource Manager] as RESOURCE_MGR #9B59B6
  [Booking Orchestrator] as ORCHESTRATOR #9B59B6
}

' =====================================
' ADAPTER LAYER
' =====================================
package "E-Commerce Adapter Layer (Optional)" as ADAPTER <<Rectangle>> FUTURAMA_GREEN {
  [EcommerceAdapter Interface] as ADAPTER_IF #2ECC71

  package "Platform Adapters" as ADAPTERS #43E095 {
    [OXID Adapter] as OXID_ADAPTER #58E6A0
    [Shopware Adapter] as SHOPWARE_ADAPTER #58E6A0
    [Magento Adapter] as MAGENTO_ADAPTER #58E6A0
    [Standalone Mode] as STANDALONE_ADAPTER #58E6A0
  }
}

note right of ADAPTER : <color:#FFFFFF><b>Backend Integration</b></color><color:#FFFFFF><b>NOT Frontend!</b></color>

' =====================================
' INTEGRATION COMPONENTS
' =====================================
package "Integration Layer (Required)" as INTEGRATION <<Rectangle>> FUTURAMA_YELLOW {
  [Payment Component v4.0] as PAYMENT #F4D03F
  [Blockchain Inventory] as BLOCKCHAIN #F4D03F
}

' =====================================
' E-COMMERCE PLATFORMS
' =====================================
package "E-Commerce Platforms (Optional)" as PLATFORMS <<Rectangle>> FUTURAMA_RED {
  database "OXID eShop" as OXID_DB #E74C3C {
    [oxarticles] as OXID_PRODUCTS
    [oxorder] as OXID_ORDERS
    [oxuser] as OXID_CUSTOMERS
  }

  database "Shopware" as SHOP_DB #E74C3C {
    [product] as SHOP_PRODUCTS
    [order] as SHOP_ORDERS
    [customer] as SHOP_CUSTOMERS
  }
}

' =====================================
' CONNECTIONS: Client → Core
' =====================================
OXID_UI -down-> BOOKING_SVC : <color:#FFFFFF>via API</color>
SHOP_UI -down-> BOOKING_SVC : <color:#FFFFFF>via API</color>
STANDALONE_UI -down-> BOOKING_SVC : <color:#FFFFFF>via API</color>
MOBILE_UI -down-> BOOKING_SVC : <color:#FFFFFF>via API</color>

' =====================================
' CONNECTIONS: Core → Adapter
' =====================================
BOOKING_SVC -down-> ADAPTER_IF : <color:#FFFFFF>optional</color>
RESOURCE_MGR -down-> ADAPTER_IF : <color:#FFFFFF>sync products</color>
ORCHESTRATOR -down-> ADAPTER_IF : <color:#FFFFFF>create orders</color>

' =====================================
' CONNECTIONS: Core → Integration
' =====================================
BOOKING_SVC -down-> PAYMENT : <color:#FFFFFF>required</color>
BOOKING_SVC -down-> BLOCKCHAIN : <color:#FFFFFF>required</color>

' =====================================
' CONNECTIONS: Adapter → Platforms
' =====================================
ADAPTER_IF -down-> OXID_ADAPTER
ADAPTER_IF -down-> SHOPWARE_ADAPTER
ADAPTER_IF -down-> MAGENTO_ADAPTER
ADAPTER_IF -down-> STANDALONE_ADAPTER

OXID_ADAPTER -down-> OXID_PRODUCTS : <color:#FFFFFF>sync resources</color>
OXID_ADAPTER -down-> OXID_ORDERS : <color:#FFFFFF>create order</color>
OXID_ADAPTER -down-> OXID_CUSTOMERS : <color:#FFFFFF>fetch customer</color>

SHOPWARE_ADAPTER -down-> SHOP_PRODUCTS : <color:#FFFFFF>sync resources</color>
SHOPWARE_ADAPTER -down-> SHOP_ORDERS : <color:#FFFFFF>create order</color>
SHOPWARE_ADAPTER -down-> SHOP_CUSTOMERS : <color:#FFFFFF>fetch customer</color>

' =====================================
' FLOW DIAGRAMS
' =====================================

note as FLOW1
  <color:#FFFFFF><b>Flow 1: With E-Commerce Backend</b></color>
  <color:#FFFFFF>━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</color>
  <color:#FFFFFF>1. Admin creates BookableResource</color>
  <color:#FFFFFF>2. EcommerceAdapter syncs to Product</color>
  <color:#FFFFFF>   (oxarticles/product table)</color>
  <color:#FFFFFF>3. User browses e-commerce storefront</color>
  <color:#FFFFFF>4. User selects product, clicks "Book"</color>
  <color:#FFFFFF>5. Booking Platform: Create booking</color>
  <color:#FFFFFF>6. Payment Component: Process payment</color>
  <color:#FFFFFF>7. Blockchain: Lock inventory</color>
  <color:#FFFFFF>8. Booking confirmed</color>
  <color:#FFFFFF>9. EcommerceAdapter: Create order</color>
  <color:#FFFFFF>   (oxorder/order table)</color>
  <color:#FFFFFF>10. E-commerce: Generate invoice</color>
  <color:#FFFFFF>━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</color>
  <color:#FFFFFF><b>E-commerce role:</b></color>
  <color:#FFFFFF>• Product catalog (optional)</color>
  <color:#FFFFFF>• Customer database (optional)</color>
  <color:#FFFFFF>• Order management (optional)</color>
  <color:#FFFFFF>• Invoicing (optional)</color>
end note

note as FLOW2
  <color:#FFFFFF><b>Flow 2: Standalone Mode</b></color>
  <color:#FFFFFF>━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</color>
  <color:#FFFFFF>1. Admin creates BookableResource</color>
  <color:#FFFFFF>2. No sync (no e-commerce)</color>
  <color:#FFFFFF>3. User browses standalone UI</color>
  <color:#FFFFFF>4. User selects resource, clicks "Book"</color>
  <color:#FFFFFF>5. Booking Platform: Create booking</color>
  <color:#FFFFFF>6. Payment Component: Process payment</color>
  <color:#FFFFFF>7. Blockchain: Lock inventory</color>
  <color:#FFFFFF>8. Booking confirmed</color>
  <color:#FFFFFF>9. No order created (standalone)</color>
  <color:#FFFFFF>10. Booking Platform: Generate invoice</color>
  <color:#FFFFFF>━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</color>
  <color:#FFFFFF><b>Booking Platform handles:</b></color>
  <color:#FFFFFF>• Product catalog (internal)</color>
  <color:#FFFFFF>• Customer database (internal)</color>
  <color:#FFFFFF>• Order management (bookings ARE orders)</color>
  <color:#FFFFFF>• Invoicing (internal)</color>
end note

FLOW1 -[hidden]-> CORE
FLOW2 -[hidden]-> PLATFORMS

' =====================================
' DATA SYNC DIAGRAM
' =====================================

note as SYNC
  <color:#FFFFFF><b>Data Synchronization</b></color>
  <color:#FFFFFF>━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</color>
  <color:#FFFFFF><b>Resource → Product (One-way)</b></color>
  <color:#FFFFFF>BookableResource.id → oxarticles.OXID</color>
  <color:#FFFFFF>BookableResource.name → oxarticles.OXTITLE</color>
  <color:#FFFFFF>BookableResource.basePrice → oxarticles.OXPRICE</color>
  <color:#FFFFFF>━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</color>
  <color:#FFFFFF><b>Booking → Order (One-way)</b></color>
  <color:#FFFFFF>Booking.id → oxorder.OXBOOKINGID</color>
  <color:#FFFFFF>Booking.price → oxorder.OXTOTALORDERSUM</color>
  <color:#FFFFFF>Booking.paymentContractId → oxorder.OXPAYMENTCONTRACTID</color>
  <color:#FFFFFF>━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</color>
  <color:#FFFFFF><b>Customer ← E-Commerce (Read)</b></color>
  <color:#FFFFFF>oxuser.OXID → Booking.customerId</color>
  <color:#FFFFFF>oxuser.OXFNAME → Booking.customerFirstName</color>
  <color:#FFFFFF>oxuser.OXLNAME → Booking.customerLastName</color>
end note

SYNC -[hidden]-> ADAPTER

' =====================================
' LEGEND
' =====================================
legend left
  <color:#FFFFFF>━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</color>
  <color:#FFFFFF><b>Integration Philosophy</b></color>
  <color:#FFFFFF>━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</color>
  <color:#FFFFFF><b>Booking Platform is the source of truth</b></color>
  <color:#FFFFFF>━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</color>
  <color:#FFFFFF>❌ E-commerce is NOT the booking engine</color>
  <color:#FFFFFF>❌ E-commerce does NOT manage inventory</color>
  <color:#FFFFFF>❌ E-commerce does NOT process payments</color>
  <color:#FFFFFF>━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</color>
  <color:#FFFFFF>✅ E-commerce provides product catalog</color>
  <color:#FFFFFF>✅ E-commerce provides customer database</color>
  <color:#FFFFFF>✅ E-commerce receives final orders</color>
  <color:#FFFFFF>✅ E-commerce generates invoices</color>
  <color:#FFFFFF>━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</color>
  <color:#FFFFFF><b>E-commerce is OPTIONAL</b></color>
  <color:#FFFFFF>Booking Platform works standalone!</color>
endlegend

@enduml
