@startuml Booking Platform Module - Complete Architecture

skinparam backgroundColor #1A1A2E
skinparam roundcorner 10
skinparam shadowing true
skinparam packageStyle rectangle
skinparam linetype ortho

' Make all lines and arrows white/visible
skinparam ArrowColor #FFFFFF
skinparam linecolor #FFFFFF

' Make component text dark for bright backgrounds
skinparam componentFontColor #000000
skinparam componentFontSize 12
skinparam componentFontStyle bold

' Make package text dark for bright package backgrounds
skinparam packageFontColor #000000
skinparam packageBorderColor #FFFFFF
skinparam packageBackgroundColor transparent

' Make database/queue/cloud text dark for bright backgrounds
skinparam databaseFontColor #000000
skinparam queueFontColor #000000
skinparam cloudFontColor #000000

' Make note text white with dark background
skinparam noteFontColor #FFFFFF
skinparam noteBorderColor #FFFFFF
skinparam noteBackgroundColor #2C3E50

' Futurama Color Palette
!define FUTURAMA_ORANGE #FF6B35
!define FUTURAMA_BLUE #4ECDC4
!define FUTURAMA_PURPLE #9B59B6
!define FUTURAMA_GREEN #2ECC71
!define FUTURAMA_YELLOW #F4D03F
!define FUTURAMA_RED #E74C3C
!define FUTURAMA_CYAN #16A085
!define FUTURAMA_PINK #E91E63
!define FUTURAMA_TEAL #1ABC9C

title <color:#FF6B35><b>Booking Platform Module</b></color><color:#FFFFFF> | E-Commerce Extension Architecture</color>

' =====================================
' LAYER 0: CLIENT INTERFACES (PROVIDED BY E-COMMERCE)
' =====================================
package "Client Interfaces (Provided by E-Commerce Platform)" as CLIENTS <<Rectangle>> FUTURAMA_ORANGE {
  [Web Storefront] as WEB #FF8C61
  [Mobile App] as MOBILE #FF8C61
  [Admin Panel] as ADMIN #FF8C61
  [GraphQL API] as GRAPHQL #FF8C61
  [REST API] as REST_API #FF8C61
  [MCP Server] as MCP #FF8C61
}

note right of CLIENTS : <color:#FFFFFF><b>E-commerce already provides</b></color><color:#FFFFFF>Frontend, APIs, admin panel,</color><color:#FFFFFF>MCP connections</color>

' =====================================
' LAYER 1: E-COMMERCE PLATFORM (FOUNDATION)
' =====================================
package "E-Commerce Platform (Foundation - Required)" as ECOM_FOUNDATION <<Rectangle>> FUTURAMA_RED {

  package "E-Commerce Core Services" as ECOM_CORE #EC6B6B {
    [Product Catalog] as CATALOG #F06292
    [Customer Management] as CUST_MGT #F06292
    [Order Management] as ORDER_MGT #F06292
    [Invoicing] as INVOICING #F06292
    [ERP Integration] as ERP #F06292
    [Session Management] as SESSION #F06292
    [Authentication] as AUTH #F06292
  }

  package "B2B Features" as B2B #EC6B6B {
    [Customer Groups] as CUST_GROUPS #F06292
    [Quote System] as QUOTES #F06292
    [Approval Workflows] as APPROVALS #F06292
    [Credit Limits] as CREDIT #F06292
    [Contract Pricing] as CONTRACT_PRICE #F06292
  }

  database "OXID EE / Shopware / Magento Database" as ECOM_DB #E74C3C {
    [oxarticles / product] as PRODUCTS
    [oxuser / customer] as CUSTOMERS
    [oxorder / order] as ORDERS
    [oxorderarticles / order_line_item] as ORDER_ITEMS
  }

  package "Payment Component v4.0 (Already Integrated)" as PAYMENT_ECOM #EC6B6B {
    [Payment Gateway] as PAY_GATEWAY #F06292
    [Payment Methods] as PAY_METHODS #F06292
    [Fraud Detection] as FRAUD #F06292
  }
}

note right of ECOM_FOUNDATION : <color:#FFFFFF><b>Existing E-Commerce System</b></color><color:#FFFFFF>Already has: products, customers,</color><color:#FFFFFF>orders, B2B, payment processing,</color><color:#FFFFFF>frontend, APIs, MCP</color>

' =====================================
' LAYER 2: BOOKING PLATFORM MODULE (THIS PROJECT - EXTENDS E-COMMERCE)
' =====================================
package "Booking Platform Module (Installed via composer)" as MODULE <<Rectangle>> FUTURAMA_PURPLE {

  package "Domain Layer" as DOMAIN #9B59B6 {
    [Booking] as BOOKING #A569BD
    [BookableResource] as RESOURCE #A569BD
    [TimeSlot] as TIMESLOT #A569BD
    [AvailabilityCalendar] as CALENDAR #A569BD
    [PricingStrategy] as PRICING #A569BD
  }

  package "Application Layer" as APPLICATION #8E44AD {
    [CreateBooking UseCase] as UC_CREATE #9B59B6
    [CancelBooking UseCase] as UC_CANCEL #9B59B6
    [CheckAvailability UseCase] as UC_CHECK #9B59B6
    [ConfirmBooking UseCase] as UC_CONFIRM #9B59B6
  }

  package "Platform Adapter Layer" as ADAPTER #7D3C98 {
    [PlatformAdapter Interface] as ADAPTER_IF #8E44AD
    [OxidAdapter] as OXID_ADAPTER #9B59B6
    [ShopwareAdapter] as SHOPWARE_ADAPTER #9B59B6
    [MagentoAdapter] as MAGENTO_ADAPTER #9B59B6
  }

  package "Module Frontend Extensions" as FRONTEND_EXT #7D3C98 {
    [Booking Calendar Widget] as CAL_WIDGET #8E44AD
    [Booking Form] as BOOK_FORM #8E44AD
    [Admin Booking Manager] as ADMIN_BOOK #8E44AD
  }

  package "Module Database Tables" as MODULE_DB #7D3C98 {
    [osc_booking_bookings] as TBL_BOOKING #8E44AD
    [osc_booking_resources] as TBL_RESOURCE #8E44AD
    [osc_booking_timeslots] as TBL_TIMESLOT #8E44AD
    [osc_booking_calendars] as TBL_CALENDAR #8E44AD
  }
}

note right of MODULE : <color:#FFFFFF><b>Module extends e-commerce</b></color><color:#FFFFFF>Adds booking widgets to frontend,</color><color:#FFFFFF>extends admin panel,</color><color:#FFFFFF>adds booking-specific tables</color>

' =====================================
' LAYER 3: BLOCKCHAIN INVENTORY MANAGER (EXTERNAL)
' =====================================
package "Blockchain Inventory Manager (External - Required)" as BLOCKCHAIN <<Rectangle>> FUTURAMA_YELLOW {
  [InventoryLock] as LOCK #F5DC5F
  [BlockchainClient] as BC_CLIENT #F5DC5F
  [ConsensusEngine] as CONSENSUS #F5DC5F

  cloud "Hyperledger Fabric" as LEDGER #F4D03F {
    [Distributed Ledger] as DL
  }
}

note right of BLOCKCHAIN : <color:#FFFFFF><b>External component</b></color><color:#FFFFFF>Prevents double-booking,</color><color:#FFFFFF>distributed consensus</color>

' =====================================
' LAYER 4: EXTERNAL INVENTORY SOURCES (OPTIONAL)
' =====================================
package "External Inventory Sources (Optional)" as EXTERNAL <<Rectangle>> FUTURAMA_TEAL {
  cloud "Booking.com API" as BOOKING_COM #1ABC9C
  cloud "Amadeus GDS" as AMADEUS #1ABC9C
  cloud "Expedia API" as EXPEDIA #1ABC9C
  cloud "Airbnb API" as AIRBNB #1ABC9C
}

note right of EXTERNAL : <color:#FFFFFF><b>Optional external inventory</b></color><color:#FFFFFF>Aggregate from multiple</color><color:#FFFFFF>booking providers</color>

' =====================================
' CONNECTIONS: Clients → E-Commerce
' =====================================
WEB -down-> CATALOG : <color:#FFFFFF>browse products</color>
MOBILE -down-> CATALOG
ADMIN -down-> ORDER_MGT : <color:#FFFFFF>manage orders</color>
GRAPHQL -down-> CATALOG : <color:#FFFFFF>query</color>
REST_API -down-> CATALOG : <color:#FFFFFF>query</color>
MCP -down-> CATALOG : <color:#FFFFFF>integrations</color>

WEB -down-> SESSION : <color:#FFFFFF>user session</color>
WEB -down-> AUTH : <color:#FFFFFF>login</color>

' =====================================
' CONNECTIONS: Clients → Module Widgets
' =====================================
WEB -down-> CAL_WIDGET : <color:#FFFFFF>displays</color>
WEB -down-> BOOK_FORM : <color:#FFFFFF>displays</color>
ADMIN -down-> ADMIN_BOOK : <color:#FFFFFF>manages bookings</color>

' =====================================
' CONNECTIONS: Module → E-Commerce Foundation
' =====================================
RESOURCE -down-> PRODUCTS : <color:#FFFFFF>extends</color>
BOOKING -down-> ORDERS : <color:#FFFFFF>creates</color>
BOOKING -down-> CUSTOMERS : <color:#FFFFFF>links to</color>
BOOKING -down-> ORDER_ITEMS : <color:#FFFFFF>creates</color>

ADAPTER_IF -down-> CATALOG : <color:#FFFFFF>uses</color>
ADAPTER_IF -down-> CUST_MGT : <color:#FFFFFF>uses</color>
ADAPTER_IF -down-> ORDER_MGT : <color:#FFFFFF>uses</color>
ADAPTER_IF -down-> INVOICING : <color:#FFFFFF>uses</color>

' Module uses e-commerce payment processing
BOOKING -down-> PAY_GATEWAY : <color:#FFFFFF>via Payment Component</color>

' B2B Features Integration
BOOKING -down-> CUST_GROUPS : <color:#FFFFFF>applies</color>
BOOKING -down-> QUOTES : <color:#FFFFFF>integrates</color>
BOOKING -down-> APPROVALS : <color:#FFFFFF>respects</color>
BOOKING -down-> CREDIT : <color:#FFFFFF>enforces</color>
BOOKING -down-> CONTRACT_PRICE : <color:#FFFFFF>uses</color>

' =====================================
' CONNECTIONS: Application → Domain
' =====================================
UC_CREATE -down-> BOOKING : <color:#FFFFFF>creates</color>
UC_CANCEL -down-> BOOKING : <color:#FFFFFF>cancels</color>
UC_CHECK -down-> RESOURCE : <color:#FFFFFF>checks</color>
UC_CONFIRM -down-> BOOKING : <color:#FFFFFF>confirms</color>

BOOKING -right-> TIMESLOT : <color:#FFFFFF>has</color>
RESOURCE -right-> CALENDAR : <color:#FFFFFF>has</color>
RESOURCE -right-> PRICING : <color:#FFFFFF>uses</color>

' =====================================
' CONNECTIONS: Domain → Adapter
' =====================================
BOOKING -down-> ADAPTER_IF : <color:#FFFFFF>uses</color>
RESOURCE -down-> ADAPTER_IF : <color:#FFFFFF>uses</color>

ADAPTER_IF -down-> OXID_ADAPTER : <color:#FFFFFF>implements</color>
ADAPTER_IF -down-> SHOPWARE_ADAPTER : <color:#FFFFFF>implements</color>
ADAPTER_IF -down-> MAGENTO_ADAPTER : <color:#FFFFFF>implements</color>

' =====================================
' CONNECTIONS: Module → Blockchain
' =====================================
BOOKING -down-> LOCK : <color:#FFFFFF>requests</color>
LOCK -down-> BC_CLIENT : <color:#FFFFFF>uses</color>
BC_CLIENT -down-> CONSENSUS : <color:#FFFFFF>uses</color>
CONSENSUS -down-> DL : <color:#FFFFFF>writes to</color>

' =====================================
' CONNECTIONS: Module → Database
' =====================================
BOOKING -down-> TBL_BOOKING : <color:#FFFFFF>persists</color>
RESOURCE -down-> TBL_RESOURCE : <color:#FFFFFF>persists</color>
TIMESLOT -down-> TBL_TIMESLOT : <color:#FFFFFF>persists</color>
CALENDAR -down-> TBL_CALENDAR : <color:#FFFFFF>persists</color>

' =====================================
' CONNECTIONS: Optional External Sources
' =====================================
RESOURCE -down-> BOOKING_COM : <color:#FFFFFF>aggregates</color>
RESOURCE -down-> AMADEUS : <color:#FFFFFF>aggregates</color>
RESOURCE -down-> EXPEDIA : <color:#FFFFFF>aggregates</color>
RESOURCE -down-> AIRBNB : <color:#FFFFFF>aggregates</color>

' =====================================
' ANNOTATIONS
' =====================================

note as ECOM_PROVIDES
  <color:#FFFFFF><b>E-Commerce Platform Provides</b></color>
  <color:#FFFFFF>━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</color>
  <color:#FFFFFF><b>Frontend:</b></color>
  <color:#FFFFFF>• Web storefront (Twig/Smarty templates)</color>
  <color:#FFFFFF>• Mobile app (React Native / Flutter)</color>
  <color:#FFFFFF>• Admin panel (management UI)</color>
  <color:#FFFFFF>━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</color>
  <color:#FFFFFF><b>APIs:</b></color>
  <color:#FFFFFF>• GraphQL API (queries, mutations)</color>
  <color:#FFFFFF>• REST API (endpoints)</color>
  <color:#FFFFFF>• WebSocket (real-time updates)</color>
  <color:#FFFFFF>━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</color>
  <color:#FFFFFF><b>Integrations:</b></color>
  <color:#FFFFFF>• MCP Server (Model Context Protocol)</color>
  <color:#FFFFFF>• Payment Component v4.0</color>
  <color:#FFFFFF>• ERP connectors</color>
  <color:#FFFFFF>━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</color>
  <color:#FFFFFF><b>Infrastructure:</b></color>
  <color:#FFFFFF>• Session management</color>
  <color:#FFFFFF>• Authentication / Authorization</color>
  <color:#FFFFFF>• Caching (Redis)</color>
  <color:#FFFFFF>• Database (MySQL/MariaDB)</color>
end note

note as MODULE_EXTENDS
  <color:#FFFFFF><b>Booking Module Extensions</b></color>
  <color:#FFFFFF>━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</color>
  <color:#FFFFFF><b>Frontend Widgets:</b></color>
  <color:#FFFFFF>• Booking calendar (injected into product page)</color>
  <color:#FFFFFF>• Time slot selector</color>
  <color:#FFFFFF>• Booking confirmation form</color>
  <color:#FFFFFF>━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</color>
  <color:#FFFFFF><b>Admin Extensions:</b></color>
  <color:#FFFFFF>• Booking list / management</color>
  <color:#FFFFFF>• Resource configuration</color>
  <color:#FFFFFF>• Calendar rules editor</color>
  <color:#FFFFFF>━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</color>
  <color:#FFFFFF><b>API Extensions:</b></color>
  <color:#FFFFFF>• GraphQL: booking queries/mutations</color>
  <color:#FFFFFF>• REST: /api/bookings endpoints</color>
  <color:#FFFFFF>• Extends existing e-commerce APIs</color>
  <color:#FFFFFF>━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</color>
  <color:#FFFFFF><b>Database Extensions:</b></color>
  <color:#FFFFFF>• Adds booking-specific tables</color>
  <color:#FFFFFF>• Extends oxarticles, oxorder, oxuser</color>
end note

note as FLOW
  <color:#FFFFFF><b>Booking Flow</b></color>
  <color:#FFFFFF>━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</color>
  <color:#FFFFFF>1. Customer browses OXID storefront</color>
  <color:#FFFFFF>2. Views product "Hotel Room - Deluxe"</color>
  <color:#FFFFFF>3. Module displays booking calendar</color>
  <color:#FFFFFF>4. Customer selects dates, clicks "Book"</color>
  <color:#FFFFFF>5. Module: Check availability</color>
  <color:#FFFFFF>6. OXID: Authenticate customer</color>
  <color:#FFFFFF>7. Payment Component: Process payment</color>
  <color:#FFFFFF>8. Blockchain: Lock inventory</color>
  <color:#FFFFFF>9. Module: Create booking</color>
  <color:#FFFFFF>10. OXID: Create order</color>
  <color:#FFFFFF>11. OXID: Generate invoice</color>
  <color:#FFFFFF>12. OXID: Send confirmation email</color>
  <color:#FFFFFF>13. Order flows to ERP</color>
end note

ECOM_PROVIDES -[hidden]-> CLIENTS
MODULE_EXTENDS -[hidden]-> MODULE
FLOW -[hidden]-> BLOCKCHAIN

' =====================================
' LEGEND
' =====================================
legend left
  <color:#FFFFFF>━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</color>
  <color:#FFFFFF><b>Layer Responsibilities</b></color>
  <color:#FFFFFF>━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</color>
  <color:#FF6B35>■</color> <color:#FFFFFF>Clients - Provided by e-commerce</color>
  <color:#E74C3C>■</color> <color:#FFFFFF>E-Commerce - Foundation + APIs</color>
  <color:#9B59B6>■</color> <color:#FFFFFF>Booking Module - Extends e-commerce</color>
  <color:#F4D03F>■</color> <color:#FFFFFF>Blockchain - External inventory mgmt</color>
  <color:#1ABC9C>■</color> <color:#FFFFFF>External Sources - Optional aggregation</color>
  <color:#FFFFFF>━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</color>
  <color:#FFFFFF><b>Key Concept</b></color>
  <color:#FFFFFF>━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</color>
  <color:#FFFFFF>E-commerce provides EVERYTHING:</color>
  <color:#FFFFFF>• Frontend (web, mobile, admin)</color>
  <color:#FFFFFF>• APIs (GraphQL, REST, MCP)</color>
  <color:#FFFFFF>• Payment processing</color>
  <color:#FFFFFF>• Session management</color>
  <color:#FFFFFF>• Authentication</color>
  <color:#FFFFFF>━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</color>
  <color:#FFFFFF>Booking module just EXTENDS:</color>
  <color:#FFFFFF>• Adds widgets to existing frontend</color>
  <color:#FFFFFF>• Extends existing APIs</color>
  <color:#FFFFFF>• Adds booking-specific tables</color>
  <color:#FFFFFF>• Leverages existing infrastructure</color>
endlegend

@enduml
