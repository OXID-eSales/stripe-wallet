@startuml Request State Machine

skinparam backgroundColor #FEFEFE
skinparam state {
    BackgroundColor<<success>> #C8E6C9
    BorderColor<<success>> #4CAF50
    BackgroundColor<<error>> #FFCDD2
    BorderColor<<error>> #F44336
    BackgroundColor<<processing>> #BBDEFB
    BorderColor<<processing>> #2196F3
}

[*] --> Received : HTTP POST /paymentwatch/assume

state Received <<processing>> {
    state "Extract Request Data" as Extract
    state "Parse JSON Payload" as Parse
    [*] --> Extract
    Extract --> Parse
}

Received --> Authenticating : Client IP + API Key

state Authenticating <<processing>> {
    state "Validate IP Whitelist" as ValidateIP
    state "Validate API Key Format" as ValidateFormat
    state "Compare API Key (hash_equals)" as CompareKey

    [*] --> ValidateIP
    ValidateIP --> ValidateFormat : IP allowed
    ValidateFormat --> CompareKey : Format valid
}

Authenticating --> AuthFailed <<error>> : Invalid IP or Key
AuthFailed --> [*] : 401 Unauthorized

Authenticating --> Parsing : Authenticated

state Parsing <<processing>> {
    state "Validate Payload Structure" as ValidateStructure
    state "Extract Field Path" as ExtractField
    state "Validate Identifiers" as ValidateIds
    state "Extract Operator" as ExtractOp
    state "Parse WHERE Clause" as ParseWhere

    [*] --> ValidateStructure
    ValidateStructure --> ExtractField : Valid
    ExtractField --> ValidateIds : Extracted
    ValidateIds --> ExtractOp : Valid
    ExtractOp --> ParseWhere : Valid
}

Parsing --> ParseFailed <<error>> : Validation Error
ParseFailed --> [*] : 400 Bad Request

Parsing --> BuildingQuery : Parsed

state BuildingQuery <<processing>> {
    state "Select Operator Strategy" as SelectStrategy
    state "Sanitize Identifiers" as Sanitize
    state "Build SQL Query" as BuildSQL
    state "Bind Parameters" as BindParams

    [*] --> SelectStrategy
    SelectStrategy --> Sanitize : Strategy selected
    Sanitize --> BuildSQL : Identifiers safe
    BuildSQL --> BindParams : SQL built
}

BuildingQuery --> QueryReady : Query prepared

state QueryReady <<processing>> {
    state "Execute Query" as ExecuteQuery
    state "Fetch Result" as FetchResult

    [*] --> ExecuteQuery
    ExecuteQuery --> FetchResult : Query executed
}

QueryReady --> QueryFailed <<error>> : Database Error
QueryFailed --> [*] : 500 Internal Server Error

QueryReady --> Comparing : Result fetched

state Comparing <<processing>> {
    state "Apply Operator Strategy" as ApplyStrategy
    state "Compare Values" as CompareValues
    state "Build Response" as BuildResponse

    [*] --> ApplyStrategy
    ApplyStrategy --> CompareValues : Strategy applied
    CompareValues --> BuildResponse : Comparison done
}

Comparing --> ResponseReady <<success>> : Comparison complete

state ResponseReady <<success>> {
    state "Audit Log" as Audit
    state "Format JSON Response" as FormatJSON

    [*] --> Audit
    Audit --> FormatJSON : Logged
}

ResponseReady --> [*] : 200 OK + JSON

note top of Received
    **Entry Point**
    Extract:
    • Client IP
    • API key
    • JSON payload
end note

note right of Authenticating
    **Security Gate**
    Constant-time comparison
    prevents timing attacks
end note

note right of Parsing
    **Validation Gate**
    Prevents:
    • SQL injection
    • Invalid operators
    • Malformed requests
end note

note right of BuildingQuery
    **Safe Query Construction**
    Uses:
    • Identifier quoting
    • Parameter binding
    • Strategy pattern
end note

note bottom of ResponseReady
    **Success Response**
    {
        "assumption": true/false,
        "query_time_ms": 12.5,
        "matched_rows": 1,
        "actual_value": "..."
    }
end note

@enduml
