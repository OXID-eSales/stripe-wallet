@startuml PaymentWatch Architecture Overview
!define RECTANGLE class

skinparam componentStyle rectangle
skinparam linetype ortho
skinparam backgroundColor #FEFEFE
skinparam component {
    BackgroundColor<<external>> #E8F5E9
    BorderColor<<external>> #4CAF50
    BackgroundColor<<presentation>> #E3F2FD
    BorderColor<<presentation>> #2196F3
    BackgroundColor<<security>> #FFF3E0
    BorderColor<<security>> #FF9800
    BackgroundColor<<application>> #F3E5F5
    BorderColor<<application>> #9C27B0
    BackgroundColor<<domain>> #FCE4EC
    BorderColor<<domain>> #E91E63
    BackgroundColor<<infrastructure>> #ECEFF1
    BorderColor<<infrastructure>> #607D8B
}

package "External Test Server" <<external>> {
    [Test Suite\nPlaywright/Cypress] as TestSuite
}

package "Presentation Layer" <<presentation>> {
    [AssumptionController] as Controller
    note right of Controller
        **Responsibilities:**
        • HTTP endpoint (/paymentwatch/assume)
        • Request/response handling
        • Thin orchestration layer
        • Error handling
    end note
}

package "Security Layer" <<security>> {
    [AuthenticationService] as AuthService
    [IP Whitelist Validator] as IPValidator
    [API Key Validator] as KeyValidator

    note right of AuthService
        **Authentication:**
        • IP address verification
        • API key validation (hash_equals)
        • CIDR notation support
        • Constant-time comparison
    end note
}

package "Application Layer" <<application>> {
    [AssumptionParser] as Parser
    [AssumptionValidator] as Validator
    [AuditLogger] as Audit

    note right of Parser
        **Parsing:**
        • JSON payload validation
        • Field path parsing
        • Operator extraction
        • WHERE clause parsing
    end note
}

package "Domain Layer" <<domain>> {
    [AssumptionRequest] as Request <<Value Object>>
    [AssumptionResponse] as Response <<Value Object>>
    [QuerySpecification] as Spec <<Specification Pattern>>

    note right of Request
        **Value Objects:**
        • Immutable
        • Self-validating
        • Type-safe
    end note
}

package "Infrastructure Layer" <<infrastructure>> {
    [QueryBuilder] as QueryBuilder
    [DatabaseConnection\n(Doctrine DBAL)] as DB
    [SQL Sanitizer] as Sanitizer

    note right of QueryBuilder
        **Query Building:**
        • Safe SQL construction
        • Parameter binding
        • SQL injection prevention
        • Identifier quoting
    end note
}

' Connections
TestSuite -down-> Controller : POST /paymentwatch/assume\n+ X-API-Key header

Controller -down-> AuthService : authenticate(ip, apiKey)
AuthService -down-> IPValidator : validateIP(ip)
AuthService -down-> KeyValidator : validateKey(apiKey)

Controller -down-> Parser : parse(payload)
Parser -down-> Validator : validate(data)
Parser -down-> Request : create()

Controller -down-> QueryBuilder : execute(request)
QueryBuilder -down-> Sanitizer : sanitize(identifier)
QueryBuilder -down-> Spec : buildSpecification()
QueryBuilder -down-> DB : executeQuery(sql, params)

QueryBuilder -up-> Response : create(result)
Controller -up-> Audit : log(request, response)
Controller -up-> TestSuite : JSON response

legend right
    **Architecture Layers:**
    • Presentation: HTTP interface
    • Security: Authentication & Authorization
    • Application: Business logic orchestration
    • Domain: Core business objects
    • Infrastructure: External dependencies

    **Design Patterns:**
    • Repository Pattern (future)
    • Specification Pattern (query building)
    • Value Object Pattern (immutability)
    • Strategy Pattern (operators)
endlegend

@enduml
