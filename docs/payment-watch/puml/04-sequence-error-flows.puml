@startuml Error Flows

skinparam backgroundColor #FEFEFE
skinparam sequenceMessageAlign center

actor "Test Suite" as Test

== Error Flow 1: Authentication Failure ==

participant "AssumptionController" as Controller1
participant "AuthenticationService" as Auth1
participant "AuditLogger" as Audit1

Test -> Controller1 : POST /paymentwatch/assume\n(invalid API key)
activate Controller1

Controller1 -> Auth1 : authenticate(clientIp, invalidKey)
activate Auth1

Auth1 -> Auth1 : validateApiKey(invalidKey)
Auth1 -> Auth1 : hash_equals(expectedKey, invalidKey)
note right : Constant-time comparison

Auth1 --> Controller1 : throw AuthenticationException
deactivate Auth1

Controller1 -> Audit1 : logAuthFailure(clientIp, reason)
activate Audit1
Audit1 --> Controller1 : void
deactivate Audit1

Controller1 --> Test : 401 Unauthorized\n{"error": "Unauthorized", "details": "..."}
deactivate Controller1

== Error Flow 2: Validation Failure (SQL Injection Attempt) ==

participant "AssumptionController" as Controller2
participant "AuthenticationService" as Auth2
participant "AssumptionParser" as Parser2
participant "RequestValidator" as Validator2
participant "AuditLogger" as Audit2

Test -> Controller2 : POST /paymentwatch/assume\n(malicious payload)
activate Controller2

Controller2 -> Auth2 : authenticate(clientIp, apiKey)
activate Auth2
Auth2 --> Controller2 : void (success)
deactivate Auth2

Controller2 -> Parser2 : parse(maliciousPayload)
activate Parser2

Parser2 -> Validator2 : validateIdentifier("users; DROP TABLE--")
activate Validator2

Validator2 -> Validator2 : checkSqlKeywords("DROP")
note right
    Detect SQL keywords:
    DROP, DELETE, INSERT, etc.
end note

Validator2 --> Parser2 : throw ValidationException\n("Invalid identifier")
deactivate Validator2
deactivate Parser2

Controller2 -> Audit2 : logValidationError(payload, error)
activate Audit2
Audit2 --> Controller2 : void
deactivate Audit2

Controller2 --> Test : 400 Bad Request\n{"error": "Invalid assumption format", "details": "..."}
deactivate Controller2

== Error Flow 3: Database Query Error ==

participant "AssumptionController" as Controller3
participant "AuthenticationService" as Auth3
participant "AssumptionParser" as Parser3
participant "QueryBuilder" as QueryBuilder3
participant "Database" as DB3
participant "AuditLogger" as Audit3

Test -> Controller3 : POST /paymentwatch/assume\n(non-existent table)
activate Controller3

Controller3 -> Auth3 : authenticate(clientIp, apiKey)
activate Auth3
Auth3 --> Controller3 : void (success)
deactivate Auth3

Controller3 -> Parser3 : parse(payload)
activate Parser3
Parser3 --> Controller3 : AssumptionRequest
deactivate Parser3

Controller3 -> QueryBuilder3 : execute(request)
activate QueryBuilder3

QueryBuilder3 -> DB3 : executeQuery("SELECT ... FROM non_existent_table")
activate DB3

DB3 --> QueryBuilder3 : throw DBALException\n("Table doesn't exist")
deactivate DB3

QueryBuilder3 --> Controller3 : throw QueryException\n("Database error: Table doesn't exist")
deactivate QueryBuilder3

Controller3 -> Audit3 : logQueryError(error, request)
activate Audit3
Audit3 --> Controller3 : void
deactivate Audit3

Controller3 --> Test : 500 Internal Server Error\n{"error": "Database query failed", "details": "..."}
deactivate Controller3

== Error Flow 4: Invalid Operator ==

participant "AssumptionController" as Controller4
participant "AssumptionParser" as Parser4
participant "RequestValidator" as Validator4

Test -> Controller4 : POST /paymentwatch/assume\n(operator: "INVALID")
activate Controller4

Controller4 -> Controller4 : authenticate() [success]

Controller4 -> Parser4 : parse(payload)
activate Parser4

Parser4 -> Validator4 : validateOperator("INVALID")
activate Validator4

Validator4 -> Validator4 : checkAllowedOperators()
note right
    Allowed: ==, !=, >, <, >=, <=,
    %like%, like%, %like,
    IS NULL, IS NOT NULL
end note

Validator4 --> Parser4 : throw ValidationException\n("Invalid operator: INVALID")
deactivate Validator4
deactivate Parser4

Controller4 --> Test : 400 Bad Request\n{"error": "Invalid assumption format", "details": "Invalid operator: INVALID"}
deactivate Controller4

== Error Flow 5: Missing Required Field ==

participant "AssumptionController" as Controller5
participant "AssumptionParser" as Parser5
participant "RequestValidator" as Validator5

Test -> Controller5 : POST /paymentwatch/assume\n(missing "assumption" key)
activate Controller5

Controller5 -> Controller5 : authenticate() [success]

Controller5 -> Parser5 : parse(payload)
activate Parser5

Parser5 -> Validator5 : validatePayload(payload)
activate Validator5

Validator5 -> Validator5 : checkRequiredKeys()
note right
    Required keys:
    • assumption (object)
    • assumption.<field> (value)
end note

Validator5 --> Parser5 : throw ValidationException\n("Missing 'assumption' key")
deactivate Validator5
deactivate Parser5

Controller5 --> Test : 400 Bad Request\n{"error": "Invalid assumption format", "details": "Missing 'assumption' key"}
deactivate Controller5

legend right
    **Error Categories:**
    • 401: Authentication failures
    • 400: Validation failures (client error)
    • 500: Database/system failures (server error)

    **Security Features:**
    • SQL injection prevention
    • Constant-time key comparison
    • Identifier validation
    • Audit logging for all failures
endlegend

@enduml
