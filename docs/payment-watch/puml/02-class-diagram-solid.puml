@startuml PaymentWatch Class Diagram (SOLID Principles)

skinparam classAttributeIconSize 0
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor<<ValueObject>> #FCE4EC
    BorderColor<<ValueObject>> #E91E63
    BackgroundColor<<Service>> #E3F2FD
    BorderColor<<Service>> #2196F3
    BackgroundColor<<Interface>> #FFF3E0
    BorderColor<<Interface>> #FF9800
    BackgroundColor<<Strategy>> #F3E5F5
    BorderColor<<Strategy>> #9C27B0
}

' Interfaces (Dependency Inversion Principle)
interface AuthenticatorInterface <<Interface>> {
    + authenticate(clientIp: string, apiKey: string): void
    + {throws} AuthenticationException
}

interface ParserInterface <<Interface>> {
    + parse(payload: array): AssumptionRequest
    + {throws} ValidationException
}

interface QueryExecutorInterface <<Interface>> {
    + execute(request: AssumptionRequest): AssumptionResponse
    + {throws} QueryException
}

interface LoggerInterface <<Interface>> {
    + log(level: string, message: string, context: array): void
}

interface OperatorStrategyInterface <<Interface>> {
    + compare(actualValue: mixed, expectedValue: mixed): bool
    + buildSqlCondition(field: string): string
}

' Value Objects (Immutable)
class AssumptionRequest <<ValueObject>> {
    - tableName: string
    - fieldName: string
    - expectedValue: mixed
    - operator: string
    - whereClause: array
    --
    + __construct(...)
    + getTableName(): string
    + getFieldName(): string
    + getFieldPath(): string
    + getExpectedValue(): mixed
    + getOperator(): string
    + getWhereClause(): array
}

class AssumptionResponse <<ValueObject>> {
    - isMatch: bool
    - matchedRows: int
    - actualValue: mixed
    - queryTimeMs: float
    --
    + __construct(...)
    + isMatch(): bool
    + getMatchedRows(): int
    + getActualValue(): mixed
    + getQueryTimeMs(): float
}

class AuthConfig <<ValueObject>> {
    - allowedHosts: array
    --
    + __construct(allowedHosts: array)
    + getAllowedHosts(): array
    + isIpAllowed(ip: string): bool
}

' Services (Single Responsibility Principle)
class AssumptionController <<Service>> {
    - authenticator: AuthenticatorInterface
    - parser: ParserInterface
    - queryExecutor: QueryExecutorInterface
    - logger: LoggerInterface
    - auditLogger: AuditLogger
    --
    + __construct(...)
    + assume(request: ServerRequestInterface): ResponseInterface
    - getClientIp(request: ServerRequestInterface): string
    - jsonResponse(data: array, status: int): ResponseInterface
}

class AuthenticationService <<Service>> {
    - config: AuthConfig
    - ipValidator: IpValidator
    - keyValidator: ApiKeyValidator
    --
    + __construct(config: AuthConfig)
    + authenticate(clientIp: string, apiKey: string): void
}

class AssumptionParser <<Service>> {
    - validator: RequestValidator
    --
    + __construct(validator: RequestValidator)
    + parse(payload: array): AssumptionRequest
    - extractFieldPath(assumption: array): array
    - parseWhereClause(where: array): array
}

class QueryBuilder <<Service>> {
    - connection: Connection
    - sanitizer: SqlSanitizer
    - operatorFactory: OperatorStrategyFactory
    --
    + __construct(...)
    + execute(request: AssumptionRequest): AssumptionResponse
    - buildQuery(request: AssumptionRequest): string
    - buildParams(request: AssumptionRequest): array
}

' Strategy Pattern for Operators (Open/Closed Principle)
class EqualityOperator <<Strategy>> {
    + compare(actual: mixed, expected: mixed): bool
    + buildSqlCondition(field: string): string
}

class ComparisonOperator <<Strategy>> {
    - operator: string
    + compare(actual: mixed, expected: mixed): bool
    + buildSqlCondition(field: string): string
}

class LikeOperator <<Strategy>> {
    - pattern: string
    + compare(actual: mixed, expected: mixed): bool
    + buildSqlCondition(field: string): string
}

class NullCheckOperator <<Strategy>> {
    - checkNull: bool
    + compare(actual: mixed, expected: mixed): bool
    + buildSqlCondition(field: string): string
}

class OperatorStrategyFactory <<Service>> {
    - strategies: array
    --
    + __construct()
    + getOperator(operatorName: string): OperatorStrategyInterface
    - registerStrategies(): void
}

' Helper Services (Single Responsibility)
class IpValidator <<Service>> {
    + validate(clientIp: string, allowedIp: string): bool
    + isInCidrRange(ip: string, cidr: string): bool
    - ipToLong(ip: string): int
}

class ApiKeyValidator <<Service>> {
    + validate(providedKey: string, expectedKey: string): bool
    + isValidFormat(key: string): bool
}

class RequestValidator <<Service>> {
    + validatePayload(payload: array): void
    + validateFieldPath(fieldPath: string): void
    + validateOperator(operator: string): void
    + isValidIdentifier(name: string): bool
}

class SqlSanitizer <<Service>> {
    - connection: Connection
    + quoteIdentifier(identifier: string): string
    + sanitizeValue(value: mixed): mixed
    + preventSqlInjection(input: string): void
}

class AuditLogger <<Service>> {
    - logger: LoggerInterface
    + logRequest(requestId: string, ...): void
    + logAuthFailure(ip: string, reason: string): void
    + logQueryError(error: string, ...): void
}

' Exceptions (Interface Segregation)
class AuthenticationException {
    + __construct(message: string)
}

class ValidationException {
    + __construct(message: string)
}

class QueryException {
    + __construct(message: string)
}

' Relationships

' Dependency Injection (DIP)
AssumptionController ..> AuthenticatorInterface : depends on
AssumptionController ..> ParserInterface : depends on
AssumptionController ..> QueryExecutorInterface : depends on
AssumptionController ..> LoggerInterface : depends on

AuthenticationService ..|> AuthenticatorInterface : implements
AssumptionParser ..|> ParserInterface : implements
QueryBuilder ..|> QueryExecutorInterface : implements

' Service dependencies
AuthenticationService --> AuthConfig : uses
AuthenticationService --> IpValidator : uses
AuthenticationService --> ApiKeyValidator : uses

AssumptionParser --> RequestValidator : uses
AssumptionParser ..> AssumptionRequest : creates

QueryBuilder --> SqlSanitizer : uses
QueryBuilder --> OperatorStrategyFactory : uses
QueryBuilder ..> AssumptionResponse : creates

' Strategy Pattern
OperatorStrategyFactory --> OperatorStrategyInterface : creates
EqualityOperator ..|> OperatorStrategyInterface : implements
ComparisonOperator ..|> OperatorStrategyInterface : implements
LikeOperator ..|> OperatorStrategyInterface : implements
NullCheckOperator ..|> OperatorStrategyInterface : implements

' Value Objects
AssumptionController ..> AssumptionResponse : returns

' Exceptions
AuthenticationService ..> AuthenticationException : throws
AssumptionParser ..> ValidationException : throws
QueryBuilder ..> QueryException : throws

note top of AssumptionController
    **Single Responsibility:**
    Only handles HTTP request/response
    Delegates to specialized services
end note

note top of AuthenticatorInterface
    **Dependency Inversion:**
    Controller depends on abstraction,
    not concrete implementation
end note

note top of OperatorStrategyInterface
    **Open/Closed Principle:**
    New operators can be added
    without modifying existing code
end note

note top of AssumptionRequest
    **Immutability:**
    All properties readonly
    No setters allowed
end note

note bottom of QueryBuilder
    **Liskov Substitution:**
    Can be replaced with mock
    for testing without changes
end note

@enduml
