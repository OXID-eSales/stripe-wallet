@startuml Component Dependencies (Dependency Graph)

skinparam backgroundColor #FEFEFE
skinparam component {
    BackgroundColor<<layer1>> #E3F2FD
    BorderColor<<layer1>> #2196F3
    BackgroundColor<<layer2>> #FFF3E0
    BorderColor<<layer2>> #FF9800
    BackgroundColor<<layer3>> #F3E5F5
    BorderColor<<layer3>> #9C27B0
    BackgroundColor<<layer4>> #FCE4EC
    BorderColor<<layer4>> #E91E63
    BackgroundColor<<layer5>> #ECEFF1
    BorderColor<<layer5>> #607D8B
}

package "Layer 1: Presentation" <<layer1>> {
    [AssumptionController] as Controller
}

package "Layer 2: Security" <<layer2>> {
    [AuthenticationService] as AuthService
    [IpValidator] as IpValidator
    [ApiKeyValidator] as KeyValidator
}

package "Layer 3: Application" <<layer3>> {
    [AssumptionParser] as Parser
    [RequestValidator] as ReqValidator
    [AuditLogger] as Audit
}

package "Layer 4: Domain" <<layer4>> {
    [AssumptionRequest\n<<ValueObject>>] as Request
    [AssumptionResponse\n<<ValueObject>>] as Response
    [AuthConfig\n<<ValueObject>>] as Config
}

package "Layer 5: Infrastructure" <<layer5>> {
    [QueryBuilder] as QueryBuilder
    [OperatorStrategyFactory] as StrategyFactory
    [EqualityOperator] as EqualOp
    [ComparisonOperator] as CompOp
    [LikeOperator] as LikeOp
    [NullCheckOperator] as NullOp
    [SqlSanitizer] as Sanitizer
    [DatabaseConnection\n(Doctrine DBAL)] as DB
}

' Layer 1 dependencies
Controller --> AuthService : authenticates via
Controller --> Parser : parses via
Controller --> QueryBuilder : executes via
Controller --> Audit : logs via

' Layer 2 dependencies
AuthService --> Config : reads config
AuthService --> IpValidator : validates IP
AuthService --> KeyValidator : validates key

' Layer 3 dependencies
Parser --> ReqValidator : validates via
Parser ..> Request : creates

' Layer 4 (no dependencies - pure domain)

' Layer 5 dependencies
QueryBuilder --> StrategyFactory : gets strategy
QueryBuilder --> Sanitizer : sanitizes via
QueryBuilder --> DB : queries via
QueryBuilder ..> Response : creates

StrategyFactory ..> EqualOp : creates
StrategyFactory ..> CompOp : creates
StrategyFactory ..> LikeOp : creates
StrategyFactory ..> NullOp : creates

' Cross-layer (only value objects)
Controller ..> Response : returns

note top of Controller
    **Dependency Rule:**
    Dependencies point INWARD
    No inner layer depends on outer layer
end note

note right of Request
    **Domain Layer:**
    Zero external dependencies
    Pure business logic
    Immutable value objects
end note

note bottom of QueryBuilder
    **Infrastructure Layer:**
    External dependencies
    (Database, etc.)
    Easily mockable
end note

legend right
    **Dependency Layers (Onion Architecture):**
    1. Presentation (Controllers)
    2. Security (Auth services)
    3. Application (Use cases)
    4. Domain (Business logic)
    5. Infrastructure (External systems)

    **Rules:**
    • Dependencies point inward only
    • Inner layers have no knowledge of outer
    • Domain layer has zero dependencies
    • Infrastructure is most volatile
endlegend

@enduml
