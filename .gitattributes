# Keep the composer dist package to what the shop actually runs.
# Everything below stays in the git repository but is stripped from the
# archive composer downloads (`--prefer-dist`, i.e. the default install).
# LICENSE, README.md, CHANGELOG.md and dependencies.yaml — the last one is
# read by the shop's ModuleDependencyDao — are deliberately NOT ignored.

/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.gitleaks.toml     export-ignore
/.gitmodules        export-ignore

# Contributor-facing documents and developer tooling.
/CLAUDE.md          export-ignore
/Makefile           export-ignore
/bin                export-ignore
/recipe             export-ignore
/infection.json5    export-ignore

# Frontend build chain. assets/ ships pre-built, nothing is built during an
# installation.
/resources          export-ignore
/package.json       export-ignore
/package-lock.json  export-ignore

# Tests, including the load-test suite.
/tests              export-ignore

# Untracked as of v3.3.0; listed so a re-added copy cannot reach the package.
/composer.lock      export-ignore
/var                export-ignore

# Generated HTML documentation browser. The written documentation
# (for_merchant, for_developer, architecture, oe_payments_docs) stays.
/docs/html-docs-browser  export-ignore
