# LLM Provider: "anthropic" or "openai" (OpenAI-compatible: DeepSeek, OpenRouter, etc.)
LLM_PROVIDER=anthropic

# LLM Configuration
LLM_API_ENDPOINT=https://api.anthropic.com/v1/messages
LLM_API_KEY=your-api-key-here
LLM_MODEL=claude-sonnet-4-5-20250929

# --- Alternative: DeepSeek (use LLM_PROVIDER=openai) ---
# LLM_PROVIDER=openai
# LLM_API_ENDPOINT=https://api.deepseek.com
# LLM_API_KEY=sk-your-deepseek-key
# LLM_MODEL=deepseek-chat

# --- Alternative: OpenAI (use LLM_PROVIDER=openai) ---
# LLM_PROVIDER=openai
# LLM_API_ENDPOINT=https://api.openai.com
# LLM_API_KEY=sk-your-openai-key
# LLM_MODEL=gpt-4o

# MCP Server (OXID Stripe ACP)
MCP_SERVER_URL=https://oxideshop.local/?cl=stripemcp
MCP_BEARER_TOKEN=test-agent-key-e2e

# Shop URL (for context in system prompt)
SHOP_URL=https://oxideshop.local
