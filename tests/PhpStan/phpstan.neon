includes:
    - phpstan-baseline.neon

parameters:
    bootstrapFiles:
        - phpstan-bootstrap.php
    level: 6
    paths:
        - ../../src
    # one-page-checkout is an optional sibling integration (OpcExternalReturnCleanupHandler
    # subscribes to its events) but is NOT a composer dependency, so its classes are not on the
    # module autoloader. Index its source for symbol resolution. The relative path resolves in both
    # layouts: locally extensions/one-page-checkout, and in CI source/one-page-checkout (checked out
    # as a sibling of the module, mirroring payment-base).
    scanDirectories:
        - ../../../one-page-checkout/src
    excludePaths:
        - ../../vendor
        - ../../var (?)
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # Legacy OXID function
        - '#Function oxNew not found#'
        # Legacy constant
        - '#Constant VENDOR_PATH not found#'

        - '#Access to an undefined property OxidEsales\\Eshop\\Application\\Model\\Order::\$oxorder__#'
        - '#Access to an undefined property OxidEsales\\Eshop\\Application\\Model\\Order#'
        # OXID OrderArticle iterator can return null in foreach (getOrderArticles() iterator may yield null)
        # OXID Order extension methods added by Stripe module
        # isset() on non-nullable variable - OXID legacy pattern
        - '#Variable \$soxId in isset\(\) always exists and is not nullable#'
